enum DriverStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  phone     String

  // Sensitive — never returned on a list endpoint, only a permission-gated
  // single-driver detail view (same convention as Staff.bankAccountNumber).
  licenseNumber String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status DriverStatus @default(ACTIVE)

  createdAt DateTime @default(now())
