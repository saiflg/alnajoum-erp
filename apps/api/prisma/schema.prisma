// Alnajoum Travel ERP — Phase 1 data model
// Identity is the single authentication principal for both customers (public
// website / customer portal) and staff (internal ERP). It carries credentials,
// verification state and role assignments. Domain-specific profile data lives
// in the linked Customer or Staff record, keeping auth concerns separate from
// business data while still allowing one unified login system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityType {
  CUSTOMER
  STAFF
}

enum IdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Identity {
  id           String         @id @default(cuid())
  email        String         @unique
  phone        String?        @unique
  passwordHash String
  type         IdentityType
  status       IdentityStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  staff    Staff?

  roles         IdentityRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([type])
  @@map("identities")
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
  VIP
  GROUP
}

model Customer {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  dateOfBirth DateTime?
  nationality String?
  gender      String?

  whatsapp String?

  address String?
  city    String?
  state   String?
  country String?

  passportNumber     String?
  passportExpiryDate DateTime?

  emergencyContactName  String?
  emergencyContactPhone String?

  customerType CustomerType @default(INDIVIDUAL)

  // Staff/branch this customer's relationship is managed by. Both optional —
  // most customers are self-registered and unassigned until a manager picks
  // them up (see StaffModule's "my customers" view).
  assignedStaffId  String?
  assignedStaff    Staff?  @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedBranchId String?
  assignedBranch   Branch? @relation(fields: [assignedBranchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents                CustomerDocument[]
  familyMembers            FamilyMember[]
  flightBookings           FlightBooking[]
  flightBookingPassenger   FlightBookingPassenger[]
  invoices                 Invoice[]
  paymentIntents           PaymentIntent[]
  wallet                   Wallet?
  hajjRegistrations        HajjRegistration[]
  hajjRegistrationPilgrim  HajjRegistrationPilgrim[]
  umrahRegistrations       UmrahRegistration[]
  umrahRegistrationPilgrim UmrahRegistrationPilgrim[]
  manualPaymentSubmissions ManualPaymentSubmission[]

  @@index([assignedStaffId])
  @@index([assignedBranchId])
  @@map("customers")
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  VISA
  PHOTO
  VACCINATION_CERTIFICATE
  BIRTH_CERTIFICATE
  OTHER
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_documents")
}

enum FamilyRelationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  GUARDIAN
  OTHER
}

model FamilyMember {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  relationship FamilyRelationship
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  nationality  String?
  gender       String?
  phone        String?
  email        String?

  passportNumber     String?
  passportExpiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents                FamilyMemberDocument[]
  flightBookingPassenger   FlightBookingPassenger[]
  hajjRegistrationPilgrim  HajjRegistrationPilgrim[]
  umrahRegistrationPilgrim UmrahRegistrationPilgrim[]

  @@index([customerId])
  @@map("family_members")
}

model FamilyMemberDocument {
  id             String       @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([familyMemberId])
  @@map("family_member_documents")
}

model Staff {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeCode String    @unique
  firstName    String
  lastName     String
  jobTitle     String?
  department   String?
  hireDate     DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookedFlightBookings    FlightBooking[]
  issuedInvoices          Invoice[]
  recordedPayments        Payment[]
  assignedCustomers       Customer[]
  hajjRegistrations       HajjRegistration[]
  umrahRegistrations      UmrahRegistration[]
  walletTransactions      WalletTransaction[]
  incentives              StaffIncentive[]
  submittedManualPayments ManualPaymentSubmission[] @relation("SubmittedManualPayments")
  reviewedManualPayments  ManualPaymentSubmission[] @relation("ReviewedManualPayments")

  @@index([companyId])
  @@index([branchId])
  @@map("staff")
}

model Company {
  id                 String  @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String? @unique
  email              String?
  phone              String?
  address            String?
  website            String?
  logoUrl            String?
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  staff    Staff[]

  @@map("companies")
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  code         String
  address      String?
  city         String?
  state        String?
  country      String?
  phone        String?
  email        String?
  isHeadOffice Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff             Staff[]
  assignedCustomers Customer[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  identities  IdentityRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "company:create", "branch:update"
  module      String // e.g. "company", "branch", "user"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model IdentityRole {
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Optional scope: a role can be granted platform-wide (companyId null) or
  // limited to a specific company/branch (e.g. Branch Manager at Branch X).
  companyId String?
  branchId  String?

  assignedAt DateTime @default(now())

  @@id([identityId, roleId])
  @@index([companyId])
  @@index([branchId])
  @@map("identity_roles")
}

model RefreshToken {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  createdByIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String    @id @default(cuid())
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  action     String // e.g. "auth.login", "company.create"
  entityType String?
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum FlightProviderName {
  MOCK
  DUFFEL
  SABRE
  AMADEUS
}

enum FlightBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model FlightBooking {
  id               String @id @default(cuid())
  bookingReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Set when a staff member books on the customer's behalf; null for
  // customer self-service bookings.
  bookedByStaffId String?
  bookedByStaff   Staff?  @relation(fields: [bookedByStaffId], references: [id], onDelete: SetNull)

  provider        FlightProviderName
  providerOfferId String
  providerOrderId String?
  status          FlightBookingStatus @default(PENDING)

  currency    String
  totalAmount Int // whole currency units (e.g. NGN), no minor-unit subdivision

  tripType    TripType
  // Summary columns for indexing/list display, derived from the first and
  // last leg of the itinerary at booking time. The full per-leg routing
  // (all stops for a multi-city trip, or the return leg of a round trip)
  // lives in `itinerary` below.
  origin      String
  destination String
  departureAt DateTime
  cabinClass  CabinClass

  // Full offer snapshot (all legs, segments, fare basis, etc.) as returned
  // by the provider at booking time — provider payloads vary too much in
  // shape to model relationally, and a snapshot also preserves what was
  // actually purchased even if the provider's own record later changes.
  itinerary Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengers FlightBookingPassenger[]
  invoice    Invoice?

  @@index([customerId])
  @@index([status])
  @@index([bookedByStaffId])
  @@map("flight_bookings")
}

model FlightBookingPassenger {
  id        String        @id @default(cuid())
  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type PassengerType

  // Exactly one of these is set, identifying who this passenger is.
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  // Snapshot of traveler details at booking time, independent of later
  // profile edits.
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  passportNumber String?
  ticketNumber   String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([customerId])
  @@index([familyMemberId])
  @@map("flight_booking_passengers")
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CARD
  OTHER
  // Customer-initiated checkout through PaymentProviderPort (Paystack in
  // production, the mock provider by default) — the only method not
  // recorded by a staff member.
  ONLINE
  // Debited from the customer's wallet balance (see Wallet/WalletTransaction).
  WALLET
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable/unique rather than required: today every invoice is generated
  // from a flight booking, but the shape stays valid for a future
  // standalone invoice (e.g. a manual fee) that isn't tied to one booking.
  flightBookingId String?        @unique
  flightBooking   FlightBooking? @relation(fields: [flightBookingId], references: [id], onDelete: SetNull)

  // Same nullable/unique shape as flightBookingId — an invoice generated
  // from a Hajj or Umrah registration instead of a flight booking.
  hajjRegistrationId  String?            @unique
  hajjRegistration    HajjRegistration?  @relation(fields: [hajjRegistrationId], references: [id], onDelete: SetNull)
  umrahRegistrationId String?            @unique
  umrahRegistration   UmrahRegistration? @relation(fields: [umrahRegistrationId], references: [id], onDelete: SetNull)

  status InvoiceStatus @default(ISSUED)

  currency    String
  totalAmount Int // whole currency units, no minor-unit subdivision — matches FlightBooking.totalAmount

  // Set when a staff action generated the invoice; null for a
  // system-generated invoice from a customer's own self-service booking.
  issuedByStaffId String?
  issuedByStaff   Staff?  @relation(fields: [issuedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems                InvoiceLineItem[]
  payments                 Payment[]
  paymentIntents           PaymentIntent[]
  manualPaymentSubmissions ManualPaymentSubmission[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  amount      Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id               String @id @default(cuid())
  paymentReference String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Int
  method PaymentMethod
  note   String?

  // Payments are always recorded by a staff member (cash/bank transfer/POS
  // handled in-office) — there's no customer self-service payment path
  // until a real online gateway (Paystack/Flutterwave) is integrated.
  recordedByStaffId String?
  recordedByStaff   Staff?  @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  // Set only when this Payment was created by approving a manual payment
  // submission (see ManualPaymentSubmission) — the reverse of its paymentId.
  manualPaymentSubmission ManualPaymentSubmission?

  @@index([invoiceId])
  @@map("payments")
}

/**
 * One customer-initiated online checkout attempt against an invoice.
 * Created PENDING before redirecting to the provider's hosted checkout
 * page; flipped to SUCCEEDED (which also creates the matching Payment row)
 * or FAILED once the provider confirms the outcome — via the browser
 * returning to the verify endpoint, and/or the provider's webhook, since
 * either can arrive first or the browser callback may never happen at all
 * (tab closed mid-payment).
 */
model PaymentIntent {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // The provider's transaction reference — what ties an initiated checkout
  // to the provider's later verify/webhook callback.
  reference String @unique
  provider  String // "mock" | "paystack"

  amount   Int
  currency String

  status PaymentIntentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("payment_intents")
}

enum NotificationType {
  STAFF_TEMP_PASSWORD
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  CONTACT_MESSAGE
  WALLET_DEPOSIT
  WALLET_DEBIT
  INSTALLMENT_REMINDER
  PAYMENT_OVERDUE
  HAJJ_UMRAH_DEADLINE
  DOCUMENT_MISSING
  MANUAL_PAYMENT_SUBMITTED
  MANUAL_PAYMENT_APPROVED
  MANUAL_PAYMENT_REJECTED
}

enum NotificationStatus {
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

/**
 * Append-only send log — every attempt is recorded regardless of outcome,
 * so a failed send is visible without needing real inbox access. Not
 * linked to other models by foreign key (mirrors AuditLog): the recipient
 * address and rendered body are the durable record, since the underlying
 * Customer/Staff/Invoice may change or be deleted after the fact.
 */
model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  channel   NotificationChannel @default(EMAIL)
  recipient String
  subject   String
  body      String
  status    NotificationStatus

  errorMessage String?

  // Set when this notification also belongs in an identity's in-app feed
  // (dashboard "Notifications" widget) — the append-only send log above is
  // reused as the in-app store rather than duplicating rows into a second
  // table. Null for notifications that only ever left the system by email
  // (e.g. the public contact form).
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  isRead     Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([identityId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 2 — Wallet
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  ADJUSTMENT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

model Wallet {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currency String @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

/**
 * Ledger-safe: the wallet never carries a stored balance column. Balance is
 * always the sum of `amount` (signed — positive credits, negative debits)
 * across this wallet's COMPLETED transactions, computed on read. This makes
 * an incorrect balance structurally impossible — there is nothing to drift
 * out of sync with the transaction history, because the history *is* the
 * balance. See WalletService.getBalance().
 */
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  // Signed whole-currency-unit amount: positive credits the wallet
  // (DEPOSIT, REFUND, TRANSFER_IN), negative debits it (PAYMENT, WITHDRAWAL,
  // TRANSFER_OUT). ADJUSTMENT can be either sign, for a manual correction.
  amount      Int
  currency    String
  description String
  reference   String @unique

  // What this transaction paid for / originated from, when applicable —
  // e.g. the invoice a wallet PAYMENT settled, or the PaymentIntent
  // reference for an online DEPOSIT. Free-form on purpose: a wallet
  // transaction can point at very different kinds of source records.
  invoiceId String?

  // Set for staff-initiated transactions (manual deposit/adjustment/
  // withdrawal by Finance); null for customer self-service deposits/payments.
  createdByStaffId String?
  createdByStaff   Staff?  @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([status])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Phase 2 — Hajj & Umrah package management
// ---------------------------------------------------------------------------

enum PackageStatus {
  DRAFT
  PUBLISHED
  FULLY_BOOKED
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model HajjPackage {
  id          String  @id @default(cuid())
  name        String
  description String?

  price        Int // selling price per pilgrim, whole currency units
  internalCost Int? // cost price per pilgrim — never exposed on customer-facing routes
  currency     String @default("NGN")

  durationDays  Int?
  departureDate DateTime?
  returnDate    DateTime?

  airline         String?
  hotel           String?
  accommodation   String?
  transport       String?
  meals           String?
  visaIncluded    Boolean @default(true)
  ziyaratIncluded Boolean @default(true)
  guideIncluded   Boolean @default(true)

  maxPilgrims    Int
  seatsAvailable Int

  paymentPlan        String? // free-text description of the installment structure
  termsAndConditions String?
  requiredDocuments  String? // free-text list, e.g. "Passport, Yellow Card, 2 photos"

  status PackageStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations HajjRegistration[]

  @@map("hajj_packages")
}

/**
 * One family head's registration against a package — may cover several
 * pilgrims (see HajjRegistrationPilgrim), mirroring how FlightBooking covers
 * several FlightBookingPassenger rows. Generates exactly one Invoice, whose
 * existing partial-payment machinery (Payment/PaymentIntent, PARTIALLY_PAID
 * status) is what implements Hajj installment payments — no separate
 * installment ledger needed.
 */
model HajjRegistration {
  id                 String @id @default(cuid())
  registrationNumber String @unique

  packageId String
  package   HajjPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  registeredByStaffId String?
  registeredByStaff   Staff?  @relation(fields: [registeredByStaffId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(PENDING)

  currency    String
  totalAmount Int // package.price × pilgrim count, snapshotted at registration time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims HajjRegistrationPilgrim[]
  invoice  Invoice?

  @@index([packageId])
  @@index([customerId])
  @@map("hajj_registrations")
}

model HajjRegistrationPilgrim {
  id             String           @id @default(cuid())
  registrationId String
  registration   HajjRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Exactly one of these is set, identifying who this pilgrim is (same
  // shape as FlightBookingPassenger).
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  firstName      String
  lastName       String
  passportNumber String?

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@map("hajj_registration_pilgrims")
}

enum UmrahPackageType {
  GROUP
  FAMILY
  VIP
  ECONOMY
  CUSTOM
}

model UmrahPackage {
  id          String           @id @default(cuid())
  name        String
  description String?
  packageType UmrahPackageType @default(GROUP)

  costPrice     Int // internal cost per pilgrim — never exposed on customer-facing routes
  sellingPrice  Int
  currency      String @default("NGN")
  // Staff incentive rule evaluated on each approved payment against a
  // registration for this package, e.g. { "percent": 2 } = 2% of the amount
  // paid credited to the registering staff member as a StaffIncentive.
  incentiveRule Json?

  hotel        String?
  flight       String?
  transport    String?
  visaIncluded Boolean @default(true)

  durationDays  Int?
  departureDate DateTime?
  returnDate    DateTime?

  maxPilgrims    Int
  seatsAvailable Int

  status PackageStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations UmrahRegistration[]

  @@map("umrah_packages")
}

model UmrahRegistration {
  id                 String @id @default(cuid())
  registrationNumber String @unique

  packageId String
  package   UmrahPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  registeredByStaffId String?
  registeredByStaff   Staff?  @relation(fields: [registeredByStaffId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(PENDING)

  currency    String
  totalAmount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims UmrahRegistrationPilgrim[]
  invoice  Invoice?

  @@index([packageId])
  @@index([customerId])
  @@map("umrah_registrations")
}

model UmrahRegistrationPilgrim {
  id             String            @id @default(cuid())
  registrationId String
  registration   UmrahRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  firstName      String
  lastName       String
  passportNumber String?

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@map("umrah_registration_pilgrims")
}

// ---------------------------------------------------------------------------
// Phase 2 — Manual (offline) payments requiring finance approval
// ---------------------------------------------------------------------------

enum ManualPaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
}

/**
 * A staff-submitted claim that a customer paid by cash or bank transfer.
 * Deliberately separate from Payment: submitting one has NO effect on the
 * invoice or any ledger — only approving it (PaymentsService creates the
 * real Payment row atomically with the status flip) does. This is what
 * "never affect the official financial ledger before approval" means in
 * code: the ledger-affecting row simply doesn't exist yet.
 */
model ManualPaymentSubmission {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  amount               Int
  method               PaymentMethod // CASH | BANK_TRANSFER, enforced in the DTO
  bankName             String?
  transactionReference String?
  description          String?
  receiptDocumentPath  String? // stored filename under uploads/manual-payment-receipts

  status ManualPaymentStatus @default(PENDING_VERIFICATION)

  submittedByStaffId String?
  submittedByStaff   Staff?  @relation("SubmittedManualPayments", fields: [submittedByStaffId], references: [id], onDelete: SetNull)

  reviewedByStaffId String?
  reviewedByStaff   Staff?    @relation("ReviewedManualPayments", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewNote        String?
  reviewedAt        DateTime?

  // Set once approved: the resulting real Payment row this submission became.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@map("manual_payment_submissions")
}

/**
 * A staff incentive earned from an approved payment against a Hajj/Umrah
 * registration, computed from the package's incentiveRule. Informational
 * ledger only — paying out incentives is a payroll concern outside this
 * system's scope.
 */
model StaffIncentive {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  sourceType  String // "HAJJ_REGISTRATION" | "UMRAH_REGISTRATION"
  sourceId    String
  amount      Int
  currency    String
  description String

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([sourceType, sourceId])
  @@map("staff_incentives")
}

// ---------------------------------------------------------------------------
// Integration credentials — lets an admin paste real API keys (Duffel,
// Sabre, Amadeus, Paystack, OPay, SMTP) through /admin/integrations instead
// of SSHing into the server to edit .env.prod. One row per (category,
// provider); `config` holds provider-specific secret fields as JSON (never
// echoed back to the client — see IntegrationsService). Which provider is
// active per category is a runtime setting (isActive), not a deploy-time
// env var — FlightProviderRouter/PaymentProviderRouter/
// NotificationProviderRouter re-check this on every call, so flipping the
// switch here takes effect immediately, no restart needed. The FLIGHT_
// PROVIDER/PAYMENT_PROVIDER/NOTIFICATION_PROVIDER env vars remain the
// fallback default when no row is marked active for a category.
enum IntegrationCategory {
  FLIGHT
  PAYMENT
  NOTIFICATION
}

model IntegrationCredential {
  id       String              @id @default(cuid())
  category IntegrationCategory
  provider String // "mock" | "duffel" | "sabre" | "amadeus" | "paystack" | "opay" | "smtp"
  isActive Boolean             @default(false)
  config   Json                @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([category, provider])
  @@index([category])
  @@map("integration_credentials")
}
