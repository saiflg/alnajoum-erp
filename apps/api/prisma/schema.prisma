// ---------------------------------------------------------------------------
// Phase 8 — Enterprise Hajj & Umrah pilgrim management, operations & group
// control. Deliberately reuses existing infrastructure rather than
// duplicating it:
//   - A "pilgrim" is still a HajjRegistrationPilgrim/UmrahRegistrationPilgrim
//     row, already linked to Customer/FamilyMember without a new table —
//     groups below are pure travel-cohort containers pilgrims optionally
//     join, not a parallel pilgrim record.
//   - Installments, amount paid, and outstanding balance are computed from
//     the existing HajjRegistration/UmrahRegistration → Invoice → Payment
//     chain (see HajjOpsService), never re-stored here.
//   - Visa/flight/hotel readiness is computed by matching a pilgrim's
//     customerId/familyMemberId against VisaApplication/FlightBookingPassenger
//     /HotelBookingGuest at read time — no synced/duplicated status field.
//   - Operational reminder tasks reuse the Phase 7 Task model
//     (relatedType: HAJJ_GROUP/UMRAH_GROUP) and TasksService.createAuto's
//     existing idempotency, not a second task system.
// ---------------------------------------------------------------------------

enum TravelGroupStatus {
  PLANNING
  REGISTRATION_OPEN
  ALMOST_FULL
  FULL
  DEPARTED
  IN_SAUDI_ARABIA
  RETURNING
  COMPLETED
  CANCELLED
}

model HajjGroup {
  id          String @id @default(cuid())
  groupNumber String @unique
  name        String

  packageId String?
  package   HajjPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  status TravelGroupStatus @default(PLANNING)

  departureDate DateTime?
  returnDate    DateTime?
  airline       String?
  maxCapacity   Int?

  coordinatorStaffId String?
  coordinatorStaff   Staff?  @relation("HajjGroupCoordinator", fields: [coordinatorStaffId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims        HajjRegistrationPilgrim[]
  transports      Transport[]
  roomAllocations RoomAllocation[]

  @@index([packageId])
  @@index([status])
  @@map("hajj_groups")
}

enum UmrahGroupType {
  INDIVIDUAL
  FAMILY
  GROUP
  CORPORATE
  VIP
}

model UmrahGroup {
  id          String         @id @default(cuid())
  groupNumber String         @unique
  name        String
  groupType   UmrahGroupType @default(GROUP)

  packageId String?
  package   UmrahPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  status TravelGroupStatus @default(PLANNING)

  departureDate DateTime?
  returnDate    DateTime?
  airline       String?
  maxCapacity   Int?

  coordinatorStaffId String?
  coordinatorStaff   Staff?  @relation("UmrahGroupCoordinator", fields: [coordinatorStaffId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims        UmrahRegistrationPilgrim[]
  transports      Transport[]
  roomAllocations RoomAllocation[]

  @@index([packageId])
  @@index([status])
  @@map("umrah_groups")
}

enum VehicleFleetType {
  BUS
  VAN
  SEDAN
  SUV
  OTHER
}

enum VehicleFleetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

// Internal fleet used for pilgrim transport — deliberately distinct from
// VehicleRental (a customer-facing marketplace booking with a third-party
// provider); no overlap in purpose or data.
model Vehicle {
  id          String             @id @default(cuid())
  plateNumber String             @unique
  type        VehicleFleetType
  capacity    Int
  status      VehicleFleetStatus @default(AVAILABLE)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers    Driver[]
  transports Transport[]

  @@map("hajj_ops_vehicles")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  phone     String

  // Sensitive — never returned on a list endpoint, only a permission-gated
  // single-driver detail view (same convention as Staff.bankAccountNumber).
  licenseNumber String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status DriverStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transports Transport[]

  @@index([vehicleId])
  @@map("hajj_ops_drivers")
}

enum TransportType {
  AIRPORT_TRANSFER
  MAKKAH_TRANSPORT
  MADINAH_TRANSPORT
  INTERCITY
  GROUP_BUS
  PRIVATE_VEHICLE
}

enum TransportStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Transport {
  id   String        @id @default(cuid())
  type TransportType

  // Exactly one of these is set — same "exactly one" convention as
  // HajjRegistrationPilgrim.customerId/familyMemberId.
  hajjGroupId  String?
  hajjGroup    HajjGroup?  @relation(fields: [hajjGroupId], references: [id], onDelete: SetNull)
  umrahGroupId String?
  umrahGroup   UmrahGroup? @relation(fields: [umrahGroupId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  pickupLocation  String
  dropoffLocation String
  scheduledAt     DateTime

  status TransportStatus @default(SCHEDULED)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hajjGroupId])
  @@index([umrahGroupId])
  @@map("hajj_ops_transports")
}

enum PilgrimType {
  HAJJ
  UMRAH
}

enum PilgrimCheckInEvent {
  GROUP_CHECK_IN
  AIRPORT
  TRANSPORT
  HOTEL
  DEPARTURE
}

// QR-based check-in event log (spec #34) — the QR payload itself is just
// HajjRegistrationPilgrim/UmrahRegistrationPilgrim.pilgrimCode, an opaque
// internal id that never encodes passport/financial data.
model PilgrimCheckIn {
  id          String      @id @default(cuid())
  pilgrimType PilgrimType
  // Polymorphic by design (HajjRegistrationPilgrim.id or
  // UmrahRegistrationPilgrim.id) — same convention already used for
  // StaffIncentive's sourceType/sourceId pairing.
  pilgrimId   String

  event    PilgrimCheckInEvent
  location String?

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([pilgrimType, pilgrimId])
  @@map("pilgrim_check_ins")
}

enum ReadinessStatus {
  GREEN
  AMBER
  RED
}

// Spec #30: the readiness/departure-checklist status is computed live
// (HajjOpsService.computeReadiness) from real documents/visa/payment/flight/
// hotel state — this table exists only for the explicit, audited manual
// override staff cannot apply without the CHECKLIST_OVERRIDE permission.
model PilgrimReadinessOverride {
  id          String      @id @default(cuid())
  pilgrimType PilgrimType
  pilgrimId   String

  status ReadinessStatus
  reason String

  overriddenByStaffId String
  overriddenByStaff   Staff    @relation(fields: [overriddenByStaffId], references: [id], onDelete: Restrict)
  overriddenAt        DateTime @default(now())

  @@index([pilgrimType, pilgrimId])
  @@map("pilgrim_readiness_overrides")
}

// ---------------------------------------------------------------------------
// Phase 8 continued — room allocation, group manifest support.
// Deliberately a lightweight, group-scoped room roster rather than wiring
// into the Phase 5 Hotel/HotelRoomType catalog: HajjPackage/UmrahPackage's
// `hotel` field has always been free text (packages aren't booked through
// the catalog), so a room here is identified by hotelName/roomNumber, not a
// HotelRoomType id. Capacity conflicts are prevented at the application
// layer (RoomAllocationService.assign), not a DB constraint, since the room
// "capacity" is data (varies per room), not a fixed schema shape.
// ---------------------------------------------------------------------------

model RoomAllocation {
  id String @id @default(cuid())

  hajjGroupId  String?
  hajjGroup    HajjGroup?  @relation(fields: [hajjGroupId], references: [id], onDelete: Cascade)
  umrahGroupId String?
  umrahGroup   UmrahGroup? @relation(fields: [umrahGroupId], references: [id], onDelete: Cascade)

  // Snapshotted at creation time — always equal to hotelBooking.hotelName
  // when linked (see RoomAllocationService.create), free text otherwise.
  // Packages have never been booked through the Phase 5 catalog (see this
  // file's Phase 8 header comment), so free text stays the default; this
  // link is what "deeper hotel-catalog integration" means in practice —
  // an optional, traceable connection to a real, priced, dated booking
  // when ops actually makes one, not a requirement to always have one.
  hotelName String

  hotelBookingId String?
  hotelBooking   HotelBooking? @relation(fields: [hotelBookingId], references: [id], onDelete: SetNull)

  roomType   String? // e.g. "Double", "Quad" — free text, matches package.hotel's own convention
  roomNumber String
  capacity   Int     @default(2)

  occupants RoomAllocationOccupant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hajjGroupId])
  @@index([umrahGroupId])
  @@map("room_allocations")
}

model RoomAllocationOccupant {
  id               String         @id @default(cuid())
  roomAllocationId String
  roomAllocation   RoomAllocation @relation(fields: [roomAllocationId], references: [id], onDelete: Cascade)

  pilgrimType PilgrimType
  pilgrimId   String

  checkedInAt DateTime?

  createdAt DateTime @default(now())

  // A pilgrim occupies at most one room per allocation batch — same pilgrim
  // can't be double-booked into two rooms of the same group.
  @@unique([roomAllocationId, pilgrimType, pilgrimId])
  @@index([pilgrimType, pilgrimId])
  @@map("room_allocation_occupants")
}
