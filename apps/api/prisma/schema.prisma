// Alnajoum Travel ERP — Phase 1 data model
// Identity is the single authentication principal for both customers (public
// website / customer portal) and staff (internal ERP). It carries credentials,
// verification state and role assignments. Domain-specific profile data lives
// in the linked Customer or Staff record, keeping auth concerns separate from
// business data while still allowing one unified login system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityType {
  CUSTOMER
  STAFF
}

enum IdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Identity {
  id           String         @id @default(cuid())
  email        String         @unique
  phone        String?        @unique
  passwordHash String
  type         IdentityType
  status       IdentityStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  staff    Staff?

  roles         IdentityRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  aiUsageLogs   AiUsageLog[]

  // Phase 6 — finance: who posted a journal entry / recorded a company
  // investment, when it wasn't a Staff-attributed action (e.g. a system
  // job) or when the finance screens simply record the logged-in identity
  // directly rather than looking up their Staff row a second time.
  journalEntries     JournalEntry[]
  companyInvestments CompanyInvestment[]

  // Phase 7 — per-identity notification channel preferences.
  notificationPreference NotificationPreference?

  // Phase 11 — 2FA recovery codes and API keys this identity owns.
  recoveryCodes TwoFactorRecoveryCode[]
  apiKeys       ApiKey[]
  approvalRequestsMade     ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisionsMade    ApprovalDecision[] @relation("ApprovalDecider")

  @@index([type])
  @@map("identities")
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
  VIP
  GROUP
}

model Customer {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Phase 11 spec #2/#3 — the tenant boundary. Required (not derived only
  // from assignedBranch, which is nullable for a self-registered customer
  // with no staff/branch assigned yet) so every customer is isolable even
  // before anyone picks them up. Defaults to the single pre-Phase-11
  // Company for every existing row (see the Phase 11 migration) —
  // multi-tenant support is additive, not a breaking change for the one
  // agency that has used this platform so far.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  firstName   String
  lastName    String
  dateOfBirth DateTime?
  nationality String?
  gender      String?

  whatsapp String?

  // Phase 14 — the `whatsapp` field above stays the number itself
  // (unchanged); these track the Meta-policy consent/verification state
  // for it. `whatsapp` can be set (e.g. copied from `phone` at signup)
  // with no consent yet — opt-in is a distinct, explicit event, never
  // inferred from the number simply being on file.
  whatsappOptIn      Boolean   @default(false)
  whatsappOptInAt    DateTime?
  whatsappOptOutAt   DateTime?
  // Set once this phone number has completed the OTP link flow (spec
  // #7/#8) — required before a conversation on this number may see
  // anything beyond public self-service content.
  whatsappVerifiedAt DateTime?
  preferredLanguage  String?   @default("en")

  address String?
  city    String?
  state   String?
  country String?

  passportNumber     String?
  passportExpiryDate DateTime?

  emergencyContactName  String?
  emergencyContactPhone String?

  customerType CustomerType @default(INDIVIDUAL)

  // Staff/branch this customer's relationship is managed by. Both optional —
  // most customers are self-registered and unassigned until a manager picks
  // them up (see StaffModule's "my customers" view).
  assignedStaffId  String?
  assignedStaff    Staff?  @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedBranchId String?
  assignedBranch   Branch? @relation(fields: [assignedBranchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents                CustomerDocument[]
  familyMembers            FamilyMember[]
  flightBookings           FlightBooking[]
  flightBookingPassenger   FlightBookingPassenger[]
  invoices                 Invoice[]
  paymentIntents           PaymentIntent[]
  wallet                   Wallet?
  hajjRegistrations        HajjRegistration[]
  hajjRegistrationPilgrim  HajjRegistrationPilgrim[]
  umrahRegistrations       UmrahRegistration[]
  umrahRegistrationPilgrim UmrahRegistrationPilgrim[]
  manualPaymentSubmissions ManualPaymentSubmission[]
  hotelBookings            HotelBooking[]
  vehicleRentals           VehicleRental[]
  visaApplications         VisaApplication[]
  visaIncentivesEarned     StaffIncentive[]
  hotelBookingGuests       HotelBookingGuest[]
  travelPackages           TravelPackage[]

  // Phase 7 — CRM, support, communication.
  convertedFromLeads Lead[]
  tasks              Task[]
  customerNotes      CustomerNote[]
  tagAssignments     CustomerTagAssignment[]
  timelineEvents     CustomerTimelineEvent[]
  feedback           CustomerFeedback[]
  complaints         Complaint[]
  supportTickets     SupportTicket[]
  referralCode       ReferralCode?           @relation("ReferralCodeOwner")
  referredBy         Referral?               @relation("ReferredCustomer")

  // Phase 14 — WhatsApp.
  whatsappConversations WhatsAppConversation[]
  whatsappConsent       WhatsAppConsent?

  @@index([assignedStaffId])
  @@index([assignedBranchId])
  @@index([companyId])
  @@map("customers")
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  VISA
  PHOTO
  VACCINATION_CERTIFICATE
  BIRTH_CERTIFICATE
  OTHER
  // Added for visa application document management (see VisaDocument) —
  // appended rather than reordered so the existing values above keep their
  // Postgres enum identity.
  BANK_STATEMENT
  INVITATION_LETTER
  HOTEL_BOOKING
  FLIGHT_ITINERARY
  GUARANTOR_ID
  GUARANTOR_DOCUMENT
  // Phase 9 — configurable country visa rules can require proof of travel
  // insurance; appended for the same "never reorder/remove" reason as the
  // block above.
  TRAVEL_INSURANCE
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_documents")
}

enum FamilyRelationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  GUARDIAN
  OTHER
}

model FamilyMember {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  relationship FamilyRelationship
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  nationality  String?
  gender       String?
  phone        String?
  email        String?

  passportNumber     String?
  passportExpiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 8: restricted-access next-of-kin contact for a pilgrim who is a
  // family member rather than the customer themself — mirrors Customer's
  // pre-existing emergencyContactName/Phone fields, gated the same way (see
  // HajjOpsController's EMERGENCY_CONTACT_VIEW permission).
  emergencyContactName  String?
  emergencyContactPhone String?

  documents                FamilyMemberDocument[]
  flightBookingPassenger   FlightBookingPassenger[]
  hajjRegistrationPilgrim  HajjRegistrationPilgrim[]
  umrahRegistrationPilgrim UmrahRegistrationPilgrim[]
  visaApplications         VisaApplication[]
  hotelBookingGuests       HotelBookingGuest[]

  @@index([customerId])
  @@map("family_members")
}

model FamilyMemberDocument {
  id             String       @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([familyMemberId])
  @@map("family_member_documents")
}

model Staff {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeCode String    @unique
  firstName    String
  lastName     String
  jobTitle     String?
  department   String?
  hireDate     DateTime?
  isActive     Boolean   @default(true)

  // Required before an incentive payout can be attempted (see
  // StaffPayoutsService) — nullable since most staff never earn a payable
  // incentive; never exposed on any list/summary endpoint, only the staff
  // member's own "my payout details" view and the finance payout screen.
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  // Phase 6 spec #12: a verified account can't be silently swapped out from
  // under Finance — StaffService.updateBankDetails() resets these to
  // false/null whenever bankName/bankAccountNumber/bankAccountName actually
  // change, and only an authorized re-verification (FINANCE.VERIFY_PAYOUT_
  // ACCOUNT) flips it back, which StaffPayoutsService.attemptPayout() now
  // requires before it will move money.
  bankAccountVerified               Boolean   @default(false)
  bankAccountVerifiedAt             DateTime?
  bankAccountVerifiedByStaffId      String?
  bankAccountVerifiedByStaff        Staff?    @relation("BankAccountVerifications", fields: [bankAccountVerifiedByStaffId], references: [id], onDelete: SetNull)
  bankAccountVerificationsPerformed Staff[]   @relation("BankAccountVerifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookedFlightBookings     FlightBooking[]
  issuedInvoices           Invoice[]
  recordedPayments         Payment[]
  assignedCustomers        Customer[]
  hajjRegistrations        HajjRegistration[]
  umrahRegistrations       UmrahRegistration[]
  walletTransactions       WalletTransaction[]
  incentives               StaffIncentive[]
  approvedIncentives       StaffIncentive[]          @relation("ApprovedIncentives")
  submittedManualPayments  ManualPaymentSubmission[] @relation("SubmittedManualPayments")
  reviewedManualPayments   ManualPaymentSubmission[] @relation("ReviewedManualPayments")
  bookedHotelBookings      HotelBooking[]
  bookedVehicleRentals     VehicleRental[]
  handledVisaApplications  VisaApplication[]
  corporateBookings        CorporateBooking[]
  payouts                  StaffPayout[]
  requestedPayouts         StaffPayout[]             @relation("RequestedPayouts")
  visaApplicationNotes     VisaApplicationNote[]
  reviewedVisaDocuments    VisaDocument[]
  verifiedGuarantors       Guarantor[]
  assignedVisaApplications VisaApplication[]         @relation("AssignedVisaApplications")

  // Phase 9 — visa & immigration operations.
  submittedVisaApplications    VisaSubmission[]
  approvedChecklistExceptions  DocumentChecklistException[]
  acknowledgedProviderMessages VisaProviderMessage[]
  requestedVisaRefunds         VisaRefund[]
  ticketedFlightBookings       FlightBooking[]              @relation("TicketedFlightBookings")
  requestedFlightRefunds       FlightRefund[]               @relation("RequestedFlightRefunds")
  requestedFlightReissues      FlightReissue[]              @relation("RequestedFlightReissues")
  flightPricingRules           FlightPricingRule[]
  createdGroupBookings         FlightGroupBooking[]         @relation("CreatedGroupBookings")
  requestedHotelRefunds        HotelRefund[]                @relation("RequestedHotelRefunds")
  completedHotelBookings       HotelBooking[]               @relation("CompletedHotelBookings")
  createdTravelPackages        TravelPackage[]              @relation("CreatedTravelPackages")

  // Phase 6 — finance.
  createdExpenses            Expense[]           @relation("CreatedExpenses")
  approvedExpenses           Expense[]           @relation("ApprovedExpenses")
  recordedSupplierPayments   SupplierPayment[]
  closedDailyClosings        DailyClosing[]
  importedBankStatementLines BankStatementLine[]

  // Phase 7 — CRM, support, communication.
  assignedLeads         Lead[]                  @relation("AssignedLeads")
  createdLeads          Lead[]                  @relation("CreatedLeads")
  leadActivities        LeadActivity[]
  assignedTasks         Task[]                  @relation("AssignedTasks")
  createdTasks          Task[]                  @relation("CreatedTasks")
  assignedTickets       SupportTicket[]         @relation("AssignedTickets")
  ticketMessages        SupportTicketMessage[]
  customerNotesCreated  CustomerNote[]
  timelineEventsCreated CustomerTimelineEvent[]
  feedbackReceived      CustomerFeedback[]
  assignedComplaints    Complaint[]             @relation("AssignedComplaints")
  complaintNotesCreated ComplaintNote[]

  // Phase 8 — Hajj & Umrah operations.
  coordinatedHajjGroups     HajjGroup[]                @relation("HajjGroupCoordinator")
  coordinatedUmrahGroups    UmrahGroup[]               @relation("UmrahGroupCoordinator")
  pilgrimCheckIns           PilgrimCheckIn[]
  pilgrimReadinessOverrides PilgrimReadinessOverride[]
  flightVoids               FlightVoid[]
  flightAncillaries         FlightAncillary[]
  flightScheduleChanges     FlightScheduleChange[]

  // Phase 14 — WhatsApp.
  assignedWhatsappConversations WhatsAppConversation[]
  whatsappMessagesSent          WhatsAppMessage[]

  // Phase 16 — supplier management.
  suppliersManaged         Supplier[]         @relation("SupplierAccountManager")
  supplierDocumentsUploaded SupplierDocument[]

  @@index([companyId])
  @@index([branchId])
  @@map("staff")
}

/**
 * Phase 11 spec #2 — this IS the platform's tenant/organization boundary,
 * not a separate concept: every Branch/Staff already hangs off a Company,
 * so formalizing multi-tenancy means completing this model's fields and
 * threading `companyId` through the records that were still missing it
 * (see Customer.companyId below), not inventing a parallel "Organization"
 * model that would just duplicate this one.
 */
model Company {
  id                 String  @id @default(cuid())
  name               String
  legalName          String?
  tradingName        String? // Phase 11 — the public-facing brand name, when it differs from the legal name
  registrationNumber String? @unique
  email              String?
  phone              String?
  address            String?
  country            String? // Phase 11 spec #2
  currency           String  @default("NGN") // Phase 11 — this tenant's default/base currency (ISO 4217); a booking's own transaction currency is never overwritten by this
  timezone           String  @default("Africa/Lagos") // Phase 11 — IANA zone, drives display only; every timestamp is still stored in UTC
  taxId              String? // Phase 11 spec #2 — tax registration number, where applicable
  subscriptionPlan   String? // Phase 11 — free-text plan name (e.g. "Standard", "Enterprise"); no billing engine exists to enforce it yet
  subscriptionStatus String? // Phase 11 — free-text (e.g. "ACTIVE", "TRIAL", "SUSPENDED"); informational only, never used to gate access on its own
  website            String?
  logoUrl            String?
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  staff      Staff[]
  customers  Customer[]
  auditLogs  AuditLog[]
  featureFlagOverrides FeatureFlagOverride[]
  systemSettings SystemSetting[]
  aiUsageLogs AiUsageLog[]
  approvalRequests ApprovalRequest[]
  approvalThresholdRules ApprovalThresholdRule[]
  whatsappConversations WhatsAppConversation[]
  flightSuppliers FlightSupplier[]
  supplierPayables SupplierPayable[]
  suppliers Supplier[]

  @@map("companies")
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  code         String
  address      String?
  city         String?
  state        String?
  country      String?
  phone        String?
  email        String?
  isHeadOffice Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff               Staff[]
  assignedCustomers   Customer[]
  corporateAccounts   CorporateAccount[]
  flightBookings      FlightBooking[]
  flightPricingRules  FlightPricingRule[]
  flightGroupBookings FlightGroupBooking[]
  hotelBookings       HotelBooking[]
  travelPackages      TravelPackage[]

  // Phase 6 — per-branch accounting (spec #21).
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]
  expenses       Expense[]
  dailyClosings  DailyClosing[]

  // Phase 7 — CRM, support.
  assignedLeads  Lead[]
  supportTickets SupportTicket[]

  // Phase 14 — WhatsApp.
  whatsappConversations WhatsAppConversation[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  identities  IdentityRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "company:create", "branch:update"
  module      String // e.g. "company", "branch", "user"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model IdentityRole {
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Optional scope: a role can be granted platform-wide (companyId null) or
  // limited to a specific company/branch (e.g. Branch Manager at Branch X).
  companyId String?
  branchId  String?

  assignedAt DateTime @default(now())

  @@id([identityId, roleId])
  @@index([companyId])
  @@index([branchId])
  @@map("identity_roles")
}

/**
 * Phase 11 spec #16 — this already carries most of what a "session"
 * needs (device/browser via userAgent, IP, issued/expiry/revoked times);
 * SessionsService presents it as a session list/revoke API rather than a
 * duplicate Session model. `lastActivityAt` is the one genuinely new
 * signal, bumped by JwtAccessStrategy on each authenticated request whose
 * access token was minted from this refresh token's family.
 */
model RefreshToken {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  createdByIp String?
  userAgent   String?
  lastActivityAt DateTime? // Phase 11 — updated opportunistically, not on every single request

  createdAt DateTime @default(now())

  @@index([identityId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String    @id @default(cuid())
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  // Phase 11 spec #25/#26 — tenant/branch context on the log row itself
  // (not just derivable from identity, since a system job or a since-
  // deleted identity may have neither) so the admin audit search can
  // filter by tenant/branch directly, in SQL, without a join per row.
  // Both nullable: platform-level actions (e.g. Super Admin creating a
  // Company) have no single owning tenant.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branchId  String?

  action     String // e.g. "auth.login", "company.create"
  entityType String?
  entityId   String?
  metadata   Json?

  // Phase 11 spec #11/#25 — a reason and a before/after snapshot for the
  // audit rows that represent a decision or a configuration change
  // (approvals, settings, role/permission edits). Left null for routine
  // create/read entries where there's no "previous state" to speak of.
  reason      String?
  previousValue Json?
  newValue      Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
  @@index([action])
  @@map("audit_logs")
}

enum FlightProviderName {
  MOCK
  DUFFEL
  SABRE
  AMADEUS
  TRAVELPORT
  TBO
}

enum FlightBookingStatus {
  PENDING
  CONFIRMED
  // Phase 4 additions — appended, not renamed/removed, so every earlier
  // reference to PENDING/CONFIRMED/CANCELLED/FAILED keeps working exactly
  // as before (see FlightsService.spec's existing assertions).
  TICKETED
  REFUND_REQUESTED
  REFUNDED
  REISSUE_REQUESTED
  REISSUED
  CANCELLED
  FAILED
  // Phase 10 additions — same append-only discipline. ON_HOLD/HOLD_EXPIRED
  // only apply to a booking created via createBooking(..., { hold: true })
  // against a provider whose capabilities().hold is true (spec #9).
  // VOID_REQUESTED/VOIDED are driven by FlightVoidsService, distinct from
  // the refund workflow (spec #18 — void is "the ticket never existed",
  // refund is "the ticket existed and is being cancelled with a penalty").
  ON_HOLD
  HOLD_EXPIRED
  VOID_REQUESTED
  VOIDED
  EXPIRED
}

enum FlightRefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum FlightReissueStatus {
  REQUESTED
  AWAITING_PAYMENT
  PAID
  COMPLETED
  FAILED
  REJECTED
}

enum FlightPricingRuleType {
  FIXED
  PERCENTAGE
}

enum FlightGroupBookingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ProviderOperation {
  SEARCH
  GET_OFFER
  CREATE_ORDER
  ISSUE_TICKET
  CANCEL_ORDER
  REFUND
  REISSUE
}

enum ProviderTransactionStatus {
  SUCCESS
  FAILURE
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model FlightBooking {
  id               String @id @default(cuid())
  bookingReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Set when a staff member books on the customer's behalf; null for
  // customer self-service bookings.
  bookedByStaffId String?
  bookedByStaff   Staff?  @relation(fields: [bookedByStaffId], references: [id], onDelete: SetNull)

  provider        FlightProviderName
  providerOfferId String
  providerOrderId String?
  status          FlightBookingStatus @default(PENDING)

  currency    String
  totalAmount Int // whole currency units (e.g. NGN), no minor-unit subdivision

  tripType    TripType
  // Summary columns for indexing/list display, derived from the first and
  // last leg of the itinerary at booking time. The full per-leg routing
  // (all stops for a multi-city trip, or the return leg of a round trip)
  // lives in `itinerary` below.
  origin      String
  destination String
  departureAt DateTime
  cabinClass  CabinClass

  // Full offer snapshot (all legs, segments, fare basis, etc.) as returned
  // by the provider at booking time — provider payloads vary too much in
  // shape to model relationally, and a snapshot also preserves what was
  // actually purchased even if the provider's own record later changes.
  itinerary Json

  // Costing/markup snapshot, same "never recompute later" principle as
  // VisaApplication.companyCostSnapshot — a later pricing-rule edit must
  // never retroactively change an already-booked price. totalAmount above
  // is what the customer actually pays; providerCost is what the provider
  // charged the agency for it, and markupAmount is the difference the
  // pricing rule added (totalAmount = providerCost + markupAmount).
  providerCost  Int?
  markupAmount  Int?
  pricingRuleId String?
  pricingRule   FlightPricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Populated once ticketing succeeds (see FlightTicketingService.issueTicket) —
  // never before, per the spec's "do not mark a booking as ticketed until
  // ticket issuance is actually confirmed."
  pnr               String?
  ticketedAt        DateTime?
  ticketedByStaffId String?
  ticketedByStaff   Staff?    @relation("TicketedFlightBookings", fields: [ticketedByStaffId], references: [id], onDelete: SetNull)

  // Provider-supplied restriction/fare messages and rules, captured at
  // search/offer time and carried through to the booking so a staff member
  // reviewing a completed booking still sees exactly what the customer was
  // shown before they booked — never invented, only ever copied from what
  // the provider actually returned (see FLIGHT_PROVIDER_WARNING_FALLBACK).
  providerWarnings Json?
  fareRules        Json?
  refundable       Boolean?
  baggageAllowance Json?

  // Set on the first successful booking attempt for a given client-supplied
  // key; a retried submission with the same key returns the existing
  // booking instead of creating a duplicate (spec #9's "prevent duplicate
  // payment and duplicate ticket issuance... use idempotency keys").
  idempotencyKey String? @unique

  // Phase 10 spec #9 — set when this booking was created with hold: true
  // against a provider whose capabilities().hold is true. Null for every
  // instant-ticketed booking (the pre-Phase-10 default). Never let payment
  // proceed once this has passed — see FlightsService.issueTicket's guard.
  holdExpiresAt DateTime?

  // Phase 10 spec #40 — same isOfflineEntry/offlineReason convention as
  // VisaApplication: a booking staff recorded from a phone call/walk-in
  // rather than a live provider search, never fabricating a provider
  // order. Still flows through the same finance/incentive/audit pipeline —
  // see FlightIncentivesService's manual-booking approval gate.
  isOfflineEntry Boolean @default(false)
  offlineReason  String?

  // Phase 10 spec #21 — set when this booking bills a corporate account
  // instead of (or alongside) the individual customer; null for every
  // ordinary self-service/staff booking. Policy limits (max fare, allowed
  // cabins, approval requirement) are enforced against this account at
  // booking time — see FlightsService.enforceCorporatePolicy.
  corporateAccountId      String?
  corporateAccount        CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  // Set at booking time when corporateAccount.requiresApproval is true;
  // null when no approval is required. Ticketing is blocked while PENDING.
  corporateApprovalStatus ApprovalStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengers      FlightBookingPassenger[]
  invoice         Invoice?
  refunds         FlightRefund[]
  reissues        FlightReissue[]
  voids           FlightVoid[]
  ancillaries     FlightAncillary[]
  logs            ProviderTransactionLog[]
  webhookEvents   FlightWebhookEvent[]
  scheduleChanges FlightScheduleChange[]

  @@index([customerId])
  @@index([status])
  @@index([bookedByStaffId])
  @@index([branchId])
  @@index([pricingRuleId])
  @@index([corporateAccountId])
  @@map("flight_bookings")
}

/**
 * Refund workflow for a cancelled/partially-cancelled FlightBooking (spec
 * #15). refundAmount is always computed, never assumed to equal the full
 * ticket price — see FlightRefundsService.calculateRefund:
 * refundAmount = ticketPrice − providerPenalty − agencyFee (+ refundableTaxes)
 */
model FlightRefund {
  id String @id @default(cuid())

  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedByStaffId  String?
  requestedByStaff    Staff?  @relation("RequestedFlightRefunds", fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  requestedByCustomer Boolean @default(false)

  ticketPrice     Int
  providerPenalty Int    @default(0)
  agencyFee       Int    @default(0)
  refundableTaxes Int    @default(0)
  refundAmount    Int
  currency        String

  status           FlightRefundStatus @default(REQUESTED)
  reason           String?
  providerResponse Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId])
  @@map("flight_refunds")
}

/**
 * Flight-change/reissue workflow (spec #16). Every request creates its own
 * row rather than mutating the booking in place, so the full change history
 * is preserved exactly as the spec asks — a booking can be reissued more
 * than once, each with its own before/after snapshot and fare math.
 */
model FlightReissue {
  id String @id @default(cuid())

  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedByStaffId String?
  requestedByStaff   Staff?  @relation("RequestedFlightReissues", fields: [requestedByStaffId], references: [id], onDelete: SetNull)

  originalOfferSnapshot Json
  newOfferSnapshot      Json
  fareDifference        Int
  changePenalty         Int    @default(0)
  totalDue              Int
  currency              String

  status           FlightReissueStatus @default(REQUESTED)
  providerResponse Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId])
  @@map("flight_reissues")
}

enum FlightVoidStatus {
  REQUESTED
  VOIDED
  FAILED
  REJECTED
}

/**
 * Phase 10 spec #18 — ticket void, deliberately a separate model/workflow
 * from FlightRefund: a void undoes a ticket within the airline's same-day
 * void window as if it never existed (no penalty, full reversal), while a
 * refund cancels an already-accepted ticket with a penalty. Only
 * meaningful once a booking is TICKETED, and only while `voidDeadline`
 * (the ticket's issue date/time plus the provider's void window, snapshot
 * at request time) hasn't passed.
 */
model FlightVoid {
  id String @id @default(cuid())

  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedByStaffId String
  requestedByStaff   Staff  @relation(fields: [requestedByStaffId], references: [id], onDelete: Restrict)

  ticketNumbers String[] // snapshot of FlightBookingPassenger.ticketNumber at request time
  voidDeadline  DateTime
  amountVoided  Int // whole amount reversed — a void has no penalty, unlike FlightRefund
  currency      String

  status           FlightVoidStatus @default(REQUESTED)
  providerResponse Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId])
  @@map("flight_voids")
}

enum FlightAncillaryType {
  BAGGAGE
  SEAT
  MEAL
  OTHER
}

enum FlightAncillaryStatus {
  REQUESTED
  CONFIRMED
  FAILED
  REFUNDED
}

/**
 * Phase 10 spec #19 — a baggage/seat/meal/other add-on purchased against an
 * existing booking, recorded separately from the base fare (never folded
 * into FlightBooking.totalAmount) so accounting/reporting can distinguish
 * ancillary revenue from ticket revenue, per the spec's own instruction.
 */
model FlightAncillary {
  id String @id @default(cuid())

  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type        FlightAncillaryType
  description String
  amount      Int
  currency    String

  status FlightAncillaryStatus @default(REQUESTED)

  purchasedByStaffId String?
  purchasedByStaff   Staff?  @relation(fields: [purchasedByStaffId], references: [id], onDelete: SetNull)

  providerReference String?
  createdAt         DateTime @default(now())

  @@index([bookingId])
  @@map("flight_ancillaries")
}

/**
 * Configurable agency markup rule (spec #18) — resolved by
 * FlightPricingService against a search/offer's route, airline, cabin,
 * booking staff, and branch. The most specific match (highest `priority`
 * among every rule whose scope fields all match or are left blank) wins;
 * see FlightPricingService.resolveRule. Never hard-coded: a booking with no
 * matching rule at all gets zero markup, which the seed data deliberately
 * avoids by always keeping one active global-default rule around.
 */
model FlightPricingRule {
  id   String @id @default(cuid())
  name String

  type    FlightPricingRuleType
  amount  Int? // whole currency units, for FIXED
  percent Float? // e.g. 5 = 5%, for PERCENTAGE

  // Scope — every non-null field here must match for the rule to apply;
  // leaving a field null makes the rule indifferent to it.
  airlineCode String?
  origin      String?
  destination String?
  cabinClass  CabinClass?
  staffId     String?
  staff       Staff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isPromotional Boolean   @default(false)
  validFrom     DateTime?
  validTo       DateTime?

  priority Int     @default(0)
  isActive Boolean @default(true)

  // Optional: route/airline-specific incentive policy override, falling
  // back to the platform default IncentivePolicy when unset — reuses the
  // exact same policy engine Phase 3 built for visa incentives rather than
  // inventing a second one (see FlightIncentivesService).
  incentivePolicyId String?
  incentivePolicy   IncentivePolicy? @relation(fields: [incentivePolicyId], references: [id], onDelete: SetNull)

  bookings FlightBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([priority])
  @@map("flight_pricing_rules")
}

enum FlightServiceFeeType {
  BOOKING
  TICKETING
  CANCELLATION
  REFUND_PROCESSING
  REISSUE
  CHANGE
  ANCILLARY
}

/**
 * Phase 10 spec #26 — configurable flat/percentage fees layered on top of
 * FlightPricingRule's fare markup, e.g. a flat ₦2,000 ticketing fee applied
 * to every ticket issued regardless of route/airline. Resolved by
 * FlightServiceFeesService.resolve(type) — the single active fee for a
 * given type wins; deliberately simpler than FlightPricingRule's
 * route/airline scoping since service fees are a flat agency charge, not a
 * fare markup.
 */
model FlightServiceFee {
  id   String               @id @default(cuid())
  type FlightServiceFeeType

  amount  Int? // whole currency units, for a flat fee
  percent Float? // e.g. 2.5 = 2.5% of the base amount, for a percentage fee

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@map("flight_service_fees")
}

/**
 * Phase 10 spec #30 — administrator-configured provider try-order for
 * flight *search only* (never booking/ticketing — see
 * FlightProviderRoutingService's doc comment and spec #31's duplicate-
 * booking protection). A rule with origin/destination left null applies
 * globally; a route-scoped rule (e.g. "NG → SA") takes priority over the
 * global default when both exist, same specific-beats-generic resolution
 * as FlightPricingRule/CountryVisaRule.
 */
model FlightProviderRoutingRule {
  id String @id @default(cuid())

  origin      String? // ISO country code or IATA airport code prefix, staff's choice — free text, never parsed
  destination String?

  // Ordered list of FlightProviderName values, e.g. ["DUFFEL","TRAVELPORT","SABRE"] —
  // stored as JSON rather than a relation table since the order itself (not
  // just membership) is the data being configured.
  providerPriority Json

  isActive Boolean @default(true)
  priority Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("flight_provider_routing_rules")
}

enum FlightSupplierType {
  GDS
  NDC
  LCC
  CONSOLIDATOR
  AIRLINE
  MANUAL
}

enum FlightSupplierStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/**
 * Phase 10 spec #22/#23 — a supplier *master record*, distinct from the
 * existing generic SupplierPayable/SupplierPayment AP ledger (which is
 * free-text-keyed and shared across Flight/Hotel/Visa). This is what a
 * FlightSupplier actually IS (contract terms, credit limit, API status);
 * SupplierPayable rows are linked to it via the new optional
 * flightSupplierId below rather than duplicating balance-tracking — the
 * balance itself is always computed live from those linked payables/
 * payments (see FlightSuppliersService.getBalance), same
 * never-a-stored-balance-column discipline as Wallet.
 */
model FlightSupplier {
  id   String             @id @default(cuid())

  // Phase 11 spec #2/#65 fix — a supplier's negotiated commission/markup/
  // credit terms are exactly the kind of commercially sensitive per-tenant
  // data spec #2's tenant isolation is about; each company maintains its
  // own supplier list rather than sharing one platform-wide catalogue.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  type FlightSupplierType

  providerCode String? // e.g. matches FlightProviderName when this supplier IS a provider account
  apiProvider  String? // free-text — which FlightProviderPort implementation settles through this supplier, if any

  currency          String @default("NGN")
  commissionPercent Float? // supplier pays the agency this % back
  markupPercent     Float? // agency's default markup when booking through this supplier (falls back to FlightPricingRule when unset)
  serviceFee        Int?

  creditLimit     Int?
  paymentTerms    String? // free text, e.g. "Net 30"
  settlementCycle String? // free text, e.g. "Weekly"

  status    FlightSupplierStatus @default(ACTIVE)
  apiStatus String? // free-text last-known API health, e.g. "Connected" | "Auth failed" — set by whatever sync/health-check calls this supplier

  notes String?

  contracts FlightSupplierContract[]
  payables  SupplierPayable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([companyId])
  @@map("flight_suppliers")
}

enum FlightSupplierContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/**
 * Phase 10 spec #24 — a supplier agreement, versioned as its own row (a
 * supplier can have several contracts over time) rather than overwriting
 * FlightSupplier's own commission/markup fields, so history is preserved.
 */
model FlightSupplierContract {
  id String @id @default(cuid())

  supplierId String
  supplier   FlightSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime?

  commissionPercent Float?
  markupPercent     Float?
  currency          String @default("NGN")

  settlementTerms   String?
  ticketingTerms    String?
  cancellationRules String?

  contactPerson String?
  documentUrl   String? // path under the existing document-storage abstraction, not a raw filesystem path

  status FlightSupplierContractStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("flight_supplier_contracts")
}

/**
 * Internal record-keeping for a negotiated group reservation (spec #17).
 * Deliberately not modeled as a live provider order — no provider in this
 * abstraction exposes an automated group-booking API, so this is staff-
 * managed: negotiate the fare and deposit terms outside the ERP, then
 * record the agreement and manifest here against a deposit/balance invoice.
 */
model FlightGroupBooking {
  id             String @id @default(cuid())
  groupReference String @unique

  groupName         String
  groupContactName  String
  groupContactPhone String
  groupContactEmail String?

  numberOfPassengers Int
  origin             String?
  destination        String
  travelDate         DateTime
  airline            String?

  negotiatedPrice Int
  currency        String
  deposit         Int    @default(0)
  balance         Int

  status FlightGroupBookingStatus @default(DRAFT)

  createdByStaffId String?
  createdByStaff   Staff?  @relation("CreatedGroupBookings", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  branchId         String?
  branch           Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  passengers FlightGroupPassenger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flight_group_bookings")
}

model FlightGroupPassenger {
  id             String             @id @default(cuid())
  groupBookingId String
  groupBooking   FlightGroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  passportNumber String?

  createdAt DateTime @default(now())

  @@index([groupBookingId])
  @@map("flight_group_passengers")
}

/**
 * Every provider round-trip, for diagnostics and the admin "Provider
 * Success Rate / Provider Errors" report (spec #24/#25). Deliberately thin:
 * safeMessage is a sanitized, human-readable summary — never the raw
 * request/response body, which could carry API secrets or passenger PII.
 */
model ProviderTransactionLog {
  id String @id @default(cuid())

  provider  FlightProviderName
  operation ProviderOperation

  requestId  String?
  responseId String?

  bookingId String?
  booking   FlightBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  status      ProviderTransactionStatus
  errorCode   String?
  safeMessage String?

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([bookingId])
  @@index([createdAt])
  @@map("provider_transaction_logs")
}

enum FlightWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/**
 * Phase 10 spec #32 — every inbound provider webhook call, recorded before
 * processing. `externalId` (the provider's own event id) is unique, so a
 * retried webhook delivery is a no-op rather than double-applying its
 * effect — the idempotency mechanism spec #32/#31 asks for, mirroring
 * FlightBooking.idempotencyKey's own uniqueness-based approach.
 */
model FlightWebhookEvent {
  id String @id @default(cuid())

  provider   FlightProviderName
  eventType  String
  externalId String             @unique

  // Sanitized payload only — never the raw provider secret/signature
  // header, same "no unnecessary sensitive data" rule ProviderTransactionLog
  // already follows.
  payload Json

  status       FlightWebhookEventStatus @default(RECEIVED)
  errorMessage String?

  bookingId String?
  booking   FlightBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([provider])
  @@index([status])
  @@map("flight_webhook_events")
}

enum FlightScheduleChangeStatus {
  DETECTED
  CUSTOMER_NOTIFIED
  ACCEPTED
  ALTERNATIVE_REQUESTED
  REFUND_REQUESTED
}

/**
 * Phase 10 spec #43 — an airline-initiated schedule change on an already-
 * ticketed booking. old/newSegmentSnapshot are full FlightSegment[] JSON
 * captures (see flight-provider.port.ts), never a diffed/interpreted
 * summary, so staff can review exactly what the provider reported.
 */
model FlightScheduleChange {
  id String @id @default(cuid())

  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  oldSegmentSnapshot Json
  newSegmentSnapshot Json

  status FlightScheduleChangeStatus @default(DETECTED)

  detectedAt         DateTime  @default(now())
  customerNotifiedAt DateTime?
  resolvedByStaffId  String?
  resolvedByStaff    Staff?    @relation(fields: [resolvedByStaffId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?

  @@index([bookingId])
  @@index([status])
  @@map("flight_schedule_changes")
}

model FlightBookingPassenger {
  id        String        @id @default(cuid())
  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type PassengerType

  // Exactly one of these is set, identifying who this passenger is.
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  // Snapshot of traveler details at booking time, independent of later
  // profile edits.
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  passportNumber String?
  ticketNumber   String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([customerId])
  @@index([familyMemberId])
  @@map("flight_booking_passengers")
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CARD
  OTHER
  // Customer-initiated checkout through PaymentProviderPort (Paystack in
  // production, the mock provider by default) — the only method not
  // recorded by a staff member.
  ONLINE
  // Debited from the customer's wallet balance (see Wallet/WalletTransaction).
  WALLET
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  // Nullable: every invoice today is billed to a Customer *except* a
  // corporate travel booking, which bills a CorporateAccount instead (see
  // corporateBookingId below) — those don't appear in a customer's own
  // invoice list, only in the corporate travel admin views and the general
  // admin invoice list.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Nullable/unique rather than required: today every invoice is generated
  // from a flight booking, but the shape stays valid for a future
  // standalone invoice (e.g. a manual fee) that isn't tied to one booking.
  flightBookingId String?        @unique
  flightBooking   FlightBooking? @relation(fields: [flightBookingId], references: [id], onDelete: SetNull)

  // Same nullable/unique shape as flightBookingId — an invoice generated
  // from a Hajj or Umrah registration instead of a flight booking.
  hajjRegistrationId  String?            @unique
  hajjRegistration    HajjRegistration?  @relation(fields: [hajjRegistrationId], references: [id], onDelete: SetNull)
  umrahRegistrationId String?            @unique
  umrahRegistration   UmrahRegistration? @relation(fields: [umrahRegistrationId], references: [id], onDelete: SetNull)

  // Same nullable/unique shape again — an invoice generated from a hotel
  // booking or vehicle rental instead of the above.
  hotelBookingId  String?        @unique
  hotelBooking    HotelBooking?  @relation(fields: [hotelBookingId], references: [id], onDelete: SetNull)
  vehicleRentalId String?        @unique
  vehicleRental   VehicleRental? @relation(fields: [vehicleRentalId], references: [id], onDelete: SetNull)

  // Same nullable/unique shape again — an invoice generated from a visa
  // application's processing fee, or a corporate travel booking's
  // consolidated per-traveler line items.
  visaApplicationId  String?           @unique
  visaApplication    VisaApplication?  @relation(fields: [visaApplicationId], references: [id], onDelete: SetNull)
  corporateBookingId String?           @unique
  corporateBooking   CorporateBooking? @relation(fields: [corporateBookingId], references: [id], onDelete: SetNull)

  // Same nullable/unique shape again — an invoice generated from a flight
  // group booking's deposit/balance agreement.
  flightGroupBooking FlightGroupBooking?

  // Same shape again — an invoice generated from a staff-built travel
  // package (spec #11-#14).
  travelPackage TravelPackage?

  status InvoiceStatus @default(ISSUED)

  currency    String
  totalAmount Int // whole currency units, no minor-unit subdivision — matches FlightBooking.totalAmount

  // Set when a staff action generated the invoice; null for a
  // system-generated invoice from a customer's own self-service booking.
  issuedByStaffId String?
  issuedByStaff   Staff?  @relation(fields: [issuedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems                InvoiceLineItem[]
  payments                 Payment[]
  paymentIntents           PaymentIntent[]
  manualPaymentSubmissions ManualPaymentSubmission[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  amount      Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id               String @id @default(cuid())
  paymentReference String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Int
  method PaymentMethod
  note   String?

  // Payments are always recorded by a staff member (cash/bank transfer/POS
  // handled in-office) — there's no customer self-service payment path
  // until a real online gateway (Paystack/Flutterwave) is integrated.
  recordedByStaffId String?
  recordedByStaff   Staff?  @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  // Set only when this Payment was created by approving a manual payment
  // submission (see ManualPaymentSubmission) — the reverse of its paymentId.
  manualPaymentSubmission ManualPaymentSubmission?

  @@index([invoiceId])
  @@map("payments")
}

/**
 * One customer-initiated online checkout attempt against an invoice.
 * Created PENDING before redirecting to the provider's hosted checkout
 * page; flipped to SUCCEEDED (which also creates the matching Payment row)
 * or FAILED once the provider confirms the outcome — via the browser
 * returning to the verify endpoint, and/or the provider's webhook, since
 * either can arrive first or the browser callback may never happen at all
 * (tab closed mid-payment).
 */
model PaymentIntent {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // The provider's transaction reference — what ties an initiated checkout
  // to the provider's later verify/webhook callback.
  reference String @unique
  provider  String // "mock" | "paystack"

  amount   Int
  currency String

  status PaymentIntentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("payment_intents")
}

enum NotificationType {
  STAFF_TEMP_PASSWORD
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  CONTACT_MESSAGE
  WALLET_DEPOSIT
  WALLET_DEBIT
  INSTALLMENT_REMINDER
  PAYMENT_OVERDUE
  HAJJ_UMRAH_DEADLINE
  DOCUMENT_MISSING
  MANUAL_PAYMENT_SUBMITTED
  MANUAL_PAYMENT_APPROVED
  MANUAL_PAYMENT_REJECTED
  VISA_APPLICATION_STATUS_CHANGED
  // Phase 3 additions.
  GUARANTOR_REQUIRED
  GUARANTOR_APPROVED
  GUARANTOR_REJECTED
  VISA_DOCUMENT_STATUS_CHANGED
  VISA_DOCUMENT_EXPIRING
  INCENTIVE_GENERATED
  INCENTIVE_APPROVED
  INCENTIVE_PAID
}

enum NotificationStatus {
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

/**
 * Append-only send log — every attempt is recorded regardless of outcome,
 * so a failed send is visible without needing real inbox access. Not
 * linked to other models by foreign key (mirrors AuditLog): the recipient
 * address and rendered body are the durable record, since the underlying
 * Customer/Staff/Invoice may change or be deleted after the fact.
 */
model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  channel   NotificationChannel @default(EMAIL)
  recipient String
  subject   String
  body      String
  status    NotificationStatus

  errorMessage String?

  // Set when this notification also belongs in an identity's in-app feed
  // (dashboard "Notifications" widget) — the append-only send log above is
  // reused as the in-app store rather than duplicating rows into a second
  // table. Null for notifications that only ever left the system by email
  // (e.g. the public contact form).
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  isRead     Boolean   @default(false)

  // Phase 7 spec #21's "related booking/application" — free-form, same
  // pattern as WalletTransaction.invoiceId / BankStatementLine.matchedId.
  relatedType String?
  relatedId   String?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([identityId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 2 — Wallet
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  ADJUSTMENT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

model Wallet {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currency String @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

/**
 * Ledger-safe: the wallet never carries a stored balance column. Balance is
 * always the sum of `amount` (signed — positive credits, negative debits)
 * across this wallet's COMPLETED transactions, computed on read. This makes
 * an incorrect balance structurally impossible — there is nothing to drift
 * out of sync with the transaction history, because the history *is* the
 * balance. See WalletService.getBalance().
 */
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  // Signed whole-currency-unit amount: positive credits the wallet
  // (DEPOSIT, REFUND, TRANSFER_IN), negative debits it (PAYMENT, WITHDRAWAL,
  // TRANSFER_OUT). ADJUSTMENT can be either sign, for a manual correction.
  amount      Int
  currency    String
  description String
  reference   String @unique

  // What this transaction paid for / originated from, when applicable —
  // e.g. the invoice a wallet PAYMENT settled, or the PaymentIntent
  // reference for an online DEPOSIT. Free-form on purpose: a wallet
  // transaction can point at very different kinds of source records.
  invoiceId String?

  // Set for staff-initiated transactions (manual deposit/adjustment/
  // withdrawal by Finance); null for customer self-service deposits/payments.
  createdByStaffId String?
  createdByStaff   Staff?  @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([status])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Phase 2 — Hajj & Umrah package management
// ---------------------------------------------------------------------------

enum PackageStatus {
  DRAFT
  PUBLISHED
  FULLY_BOOKED
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model HajjPackage {
  id          String  @id @default(cuid())
  name        String
  description String?

  price        Int // selling price per pilgrim, whole currency units
  internalCost Int? // cost price per pilgrim — never exposed on customer-facing routes
  currency     String @default("NGN")

  durationDays  Int?
  departureDate DateTime?
  returnDate    DateTime?

  airline         String?
  hotel           String?
  accommodation   String?
  transport       String?
  meals           String?
  visaIncluded    Boolean @default(true)
  ziyaratIncluded Boolean @default(true)
  guideIncluded   Boolean @default(true)

  maxPilgrims    Int
  seatsAvailable Int

  paymentPlan        String? // free-text description of the installment structure
  termsAndConditions String?
  requiredDocuments  String? // free-text list, e.g. "Passport, Yellow Card, 2 photos"

  status PackageStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations HajjRegistration[]
  groups        HajjGroup[]

  @@map("hajj_packages")
}

/**
 * One family head's registration against a package — may cover several
 * pilgrims (see HajjRegistrationPilgrim), mirroring how FlightBooking covers
 * several FlightBookingPassenger rows. Generates exactly one Invoice, whose
 * existing partial-payment machinery (Payment/PaymentIntent, PARTIALLY_PAID
 * status) is what implements Hajj installment payments — no separate
 * installment ledger needed.
 */
model HajjRegistration {
  id                 String @id @default(cuid())
  registrationNumber String @unique

  packageId String
  package   HajjPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  registeredByStaffId String?
  registeredByStaff   Staff?  @relation(fields: [registeredByStaffId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(PENDING)

  currency    String
  totalAmount Int // package.price × pilgrim count, snapshotted at registration time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims HajjRegistrationPilgrim[]
  invoice  Invoice?

  @@index([packageId])
  @@index([customerId])
  @@map("hajj_registrations")
}

model HajjRegistrationPilgrim {
  id             String           @id @default(cuid())
  registrationId String
  registration   HajjRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Exactly one of these is set, identifying who this pilgrim is (same
  // shape as FlightBookingPassenger).
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  firstName      String
  lastName       String
  passportNumber String?

  // Phase 8: optional travel-cohort assignment — a pilgrim's family/
  // customer record is never duplicated, only linked to a group container.
  groupId String?
  group   HajjGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Phase 8 spec #33: a short, random, internal-only identifier for QR
  // check-in — deliberately opaque (no passport/financial data encoded),
  // generated once on first read by HajjOpsService.ensurePilgrimCode().
  pilgrimCode String? @unique

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@index([groupId])
  @@map("hajj_registration_pilgrims")
}

enum UmrahPackageType {
  GROUP
  FAMILY
  VIP
  ECONOMY
  CUSTOM
}

model UmrahPackage {
  id          String           @id @default(cuid())
  name        String
  description String?
  packageType UmrahPackageType @default(GROUP)

  costPrice     Int // internal cost per pilgrim — never exposed on customer-facing routes
  sellingPrice  Int
  currency      String @default("NGN")
  // Staff incentive rule evaluated on each approved payment against a
  // registration for this package, e.g. { "percent": 2 } = 2% of the amount
  // paid credited to the registering staff member as a StaffIncentive.
  incentiveRule Json?

  hotel        String?
  flight       String?
  transport    String?
  visaIncluded Boolean @default(true)

  durationDays  Int?
  departureDate DateTime?
  returnDate    DateTime?

  maxPilgrims    Int
  seatsAvailable Int

  status PackageStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations UmrahRegistration[]
  groups        UmrahGroup[]

  @@map("umrah_packages")
}

model UmrahRegistration {
  id                 String @id @default(cuid())
  registrationNumber String @unique

  packageId String
  package   UmrahPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  registeredByStaffId String?
  registeredByStaff   Staff?  @relation(fields: [registeredByStaffId], references: [id], onDelete: SetNull)

  status RegistrationStatus @default(PENDING)

  currency    String
  totalAmount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims UmrahRegistrationPilgrim[]
  invoice  Invoice?

  @@index([packageId])
  @@index([customerId])
  @@map("umrah_registrations")
}

model UmrahRegistrationPilgrim {
  id             String            @id @default(cuid())
  registrationId String
  registration   UmrahRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  firstName      String
  lastName       String
  passportNumber String?

  // Phase 8: same group-assignment / QR-code shape as HajjRegistrationPilgrim.
  groupId String?
  group   UmrahGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  pilgrimCode String? @unique

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@index([groupId])
  @@map("umrah_registration_pilgrims")
}

// ---------------------------------------------------------------------------
// Phase 2 — Manual (offline) payments requiring finance approval
// ---------------------------------------------------------------------------

enum ManualPaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
}

/**
 * A staff-submitted claim that a customer paid by cash or bank transfer.
 * Deliberately separate from Payment: submitting one has NO effect on the
 * invoice or any ledger — only approving it (PaymentsService creates the
 * real Payment row atomically with the status flip) does. This is what
 * "never affect the official financial ledger before approval" means in
 * code: the ledger-affecting row simply doesn't exist yet.
 */
model ManualPaymentSubmission {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  amount               Int
  method               PaymentMethod // CASH | BANK_TRANSFER, enforced in the DTO
  bankName             String?
  transactionReference String?
  description          String?
  receiptDocumentPath  String? // stored filename under uploads/manual-payment-receipts

  status ManualPaymentStatus @default(PENDING_VERIFICATION)

  submittedByStaffId String?
  submittedByStaff   Staff?  @relation("SubmittedManualPayments", fields: [submittedByStaffId], references: [id], onDelete: SetNull)

  reviewedByStaffId String?
  reviewedByStaff   Staff?    @relation("ReviewedManualPayments", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewNote        String?
  reviewedAt        DateTime?

  // Set once approved: the resulting real Payment row this submission became.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@map("manual_payment_submissions")
}

enum IncentiveStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  // Phase 6 spec #29: an incentive tied to a booking that later gets
  // refunded/cancelled must not remain payable — set by
  // LedgerService.cancelIncentivesForSource() when a flight/hotel/visa
  // refund is processed. Terminal, like REJECTED; never set on an already
  // PAID incentive (money already moved — see the refund services' guard).
  CANCELLED
}

/**
 * A staff incentive earned from an approved payment against a Hajj/Umrah
 * registration, or (from Phase 3) from the margin on a visa application —
 * computed from the package's incentiveRule or the VisaService's
 * IncentivePolicy respectively.
 * Phase 1/2 rows (sourceType HAJJ_REGISTRATION/UMRAH_REGISTRATION) were
 * "informational only" and are backfilled to PAID by the migration that
 * added `status` — they were already-settled history, not something that
 * suddenly needs approval. Phase 3 visa incentives are the first to use the
 * real PENDING -> APPROVED -> PAID workflow end to end (see
 * VisaIncentivesService and StaffPayoutsService).
 */
model StaffIncentive {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  sourceType  String // "HAJJ_REGISTRATION" | "UMRAH_REGISTRATION" | "VISA_APPLICATION"
  sourceId    String
  amount      Int
  currency    String
  description String

  status          IncentiveStatus @default(PENDING)
  // Reference number shown to staff/finance, e.g. "INC-2026-000123" —
  // distinct from `id` (cuid) for the same reason invoiceNumber/
  // bookingReference exist alongside their own ids elsewhere.
  referenceNumber String?         @unique

  // Populated only for margin-based incentives (visa); null for the
  // simpler Hajj/Umrah incentiveRule-based ones, which never had a
  // separate company-cost/selling-price breakdown to snapshot.
  companyCost  Int?
  sellingPrice Int?
  margin       Int?

  policyId String?
  policy   IncentivePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  // Which customer this incentive was earned from — set for visa
  // incentives, null for Hajj/Umrah (those already carry the customer via
  // their registration).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  approvedByStaffId String?
  approvedByStaff   Staff?    @relation("ApprovedIncentives", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  // Reason recorded when status is set to REJECTED.
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payout StaffPayout?

  @@index([staffId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("staff_incentives")
}

enum IncentivePolicyType {
  FULL_MARGIN
  PERCENT_OF_MARGIN
  FIXED_AMOUNT
  STAFF_COMPANY_SPLIT
  STAFF_BRANCH_COMPANY_SPLIT
  CUSTOM
}

/**
 * Configurable incentive policy an admin attaches to a VisaService (or
 * leaves unset, in which case DEFAULT_INCENTIVE_POLICY in
 * visa-incentives.service.ts applies). `config` holds the type-specific
 * parameters — kept as JSON rather than one column per policy type because
 * the shape genuinely varies:
 * FULL_MARGIN             {}
 * PERCENT_OF_MARGIN       { "percent": 50 }
 * FIXED_AMOUNT            { "amount": 50000 }
 * STAFF_COMPANY_SPLIT     { "staffPercent": 70 }
 * STAFF_BRANCH_COMPANY_SPLIT { "staffPercent": 60, "branchPercent": 15 }
 * CUSTOM                  { "amount": 50000 } or { "percent": 30 } — an
 * admin-labeled variant of one of the above, kept
 * distinct so reporting can tell "we picked a
 * bespoke number for this service" apart from the
 * standard presets.
 * Only the staff share is ever recorded as a StaffIncentive row — the
 * "company"/"branch" shares are the remainder of the margin, implicit
 * rather than posted as their own ledger entries (this system has no
 * branch-level P&L ledger to post them into yet).
 */
model IncentivePolicy {
  id   String @id @default(cuid())
  name String

  type   IncentivePolicyType
  config Json                @default("{}")

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaServices       VisaService[]
  incentives         StaffIncentive[]
  flightPricingRules FlightPricingRule[]

  @@map("incentive_policies")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
}

/**
 * One payout attempt against an APPROVED StaffIncentive. Deliberately
 * separate from StaffIncentive (same reasoning as ManualPaymentSubmission
 * vs Payment): the incentive's APPROVED status doesn't move money by
 * itself, only a successful StaffPayout does — see
 * StaffPayoutsService.attemptPayout(). A failed attempt never deletes the
 * money owed; it just leaves the incentive payable again for retry.
 */
model StaffPayout {
  id String @id @default(cuid())

  incentiveId String         @unique
  incentive   StaffIncentive @relation(fields: [incentiveId], references: [id], onDelete: Restrict)

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  amount   Int
  currency String

  status PayoutStatus @default(PENDING)

  // "mock" today — see StaffPayoutProviderPort; a real bank-transfer/payroll
  // API is a DI-binding change away, same pattern as every other provider
  // in this codebase (Flight/Payment/Notification).
  provider          String
  providerReference String?
  providerError     String?

  requestedByStaffId String?
  requestedByStaff   Staff?  @relation("RequestedPayouts", fields: [requestedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([status])
  @@map("staff_payouts")
}

// ---------------------------------------------------------------------------
// Integration credentials — lets an admin paste real API keys (Duffel,
// Sabre, Amadeus, Paystack, OPay, SMTP) through /admin/integrations instead
// of SSHing into the server to edit .env.prod. One row per (category,
// provider); `config` holds provider-specific secret fields as JSON (never
// echoed back to the client — see IntegrationsService). Which provider is
// active per category is a runtime setting (isActive), not a deploy-time
// env var — FlightProviderRouter/PaymentProviderRouter/
// NotificationProviderRouter re-check this on every call, so flipping the
// switch here takes effect immediately, no restart needed. The FLIGHT_
// PROVIDER/PAYMENT_PROVIDER/NOTIFICATION_PROVIDER env vars remain the
// fallback default when no row is marked active for a category.
enum IntegrationCategory {
  FLIGHT
  PAYMENT
  NOTIFICATION
  HOTEL
  VISA
  // Phase 13 — reuses this same credential store/admin UI for the AI
  // provider's API key/model/limits rather than a parallel settings
  // mechanism (see AiProviderRouter).
  AI
  // Phase 14 — same reasoning, for WhatsAppProviderRouter.
  WHATSAPP
}

model IntegrationCredential {
  id       String              @id @default(cuid())
  category IntegrationCategory
  provider String // "mock" | "duffel" | "sabre" | "amadeus" | "paystack" | "opay" | "smtp"
  isActive Boolean             @default(false)
  config   Json                @default("{}")

  updatedAt DateTime @updatedAt

  @@unique([category, provider])
  @@index([category])
  @@map("integration_credentials")
}

enum AiUsageStatus {
  // The AI provider picked a query from AnalyticsQueryRegistry's allowlist
  // and it ran successfully.
  MATCHED
  // The AI provider didn't recognize the question as any known query — a
  // real, expected outcome (spec #37's "never fabricate certainty"), not
  // an error.
  UNMATCHED
  // The provider call itself failed (timeout, auth, malformed response).
  ERROR
}

/**
 * Phase 13 spec #40 — an audit trail of AI usage, deliberately separate
 * from AuditLog: this logs *requests to the AI layer itself* (a question,
 * which provider/model answered it, whether it matched a known query),
 * never the actual business data an answer surfaced — that's already
 * covered by whatever service executed the matched query. `question` is
 * the caller's own free-text input, kept short server-side (never a full
 * prompt/system-message dump) so this stays a usage log, not a transcript
 * store.
 */
model AiUsageLog {
  id String @id @default(cuid())

  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  requestType String // "analytics_query" — more assistant types append here later, never rename existing values
  provider    String // "mock" | "openai-compatible"
  model       String?

  question     String
  matchedQuery String?
  status       AiUsageStatus
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([identityId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Phase 14 — WhatsApp conversation engine. Deliberately scoped: this is the
// foundation (provider abstraction, conversations/messages, consent, OTP
// linking, webhook idempotency) plus one real capability (booking lookup),
// not the full 136-item spec (no separate Template/Automation/Campaign/
// Media models yet — those are real, larger subsystems layered on top of
// this once it's proven). WhatsApp is a CHANNEL on top of the existing
// ERP, never a second source of truth: it reuses Customer (including the
// existing `whatsapp` field for the number itself — only opt-in/verification
// state is new here), NotificationPreferencesService's existing
// `whatsappEnabled` toggle (a DIFFERENT concern — see WhatsAppConsent's own
// comment), CustomerTimelineEvent for CRM history, and FlightsService for
// booking data.
// ---------------------------------------------------------------------------

enum WhatsAppConversationStatus {
  OPEN
  PENDING
  ASSIGNED
  WAITING_CUSTOMER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  TEMPLATE
  IMAGE
  DOCUMENT
  VIDEO
  LOCATION
  INTERACTIVE_BUTTONS
  INTERACTIVE_LIST
  SYSTEM
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppConsentStatus {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

/** One thread per customer phone number per company — the unit staff work
 * from in the inbox. `customerId` is nullable because a message can arrive
 * from a number with no matching Customer yet (identification happens
 * server-side by phone lookup, never trusted from the message itself). */
model WhatsAppConversation {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // E.164 (the WhatsApp wa_id) — the raw join key before/without a matched
  // Customer, and still authoritative even after one is matched.
  phoneNumber String

  status           WhatsAppConversationStatus @default(OPEN)
  assignedStaffId  String?
  assignedStaff    Staff?                     @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  language         String?

  // Spec #85 — staff takeover suppresses the self-service menu/automation
  // for this conversation until released, without touching `status`
  // (which staff also drive for triage/SLA, a separate concern).
  automationPaused Boolean @default(false)

  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([phoneNumber])
  @@index([status])
  @@index([assignedStaffId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // The provider's own message id — null until an outbound send actually
  // returns one, or absent on some inbound event shapes. Used for
  // reconciling delivery/read status webhooks back to the right row.
  providerMessageId String? @unique

  direction WhatsAppMessageDirection
  type      WhatsAppMessageType       @default(TEXT)
  content   String?
  mediaUrl      String?
  mediaMimeType String?

  // Spec #87 — an internal note is stored as a message so it appears
  // in-thread for staff, but is never included in anything sent to the
  // provider/customer; every read path serving customer-visible content
  // must filter it out explicitly.
  isInternalNote Boolean @default(false)
  sentByStaffId  String?
  sentByStaff    Staff?  @relation(fields: [sentByStaffId], references: [id], onDelete: SetNull)

  status        WhatsAppMessageStatus @default(QUEUED)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  // Spec #43 — deterministic key (e.g. "booking-ticketed:{bookingId}") for
  // automated/triggered sends, so a restarted job can't double-send.
  // Null for ordinary staff replies, which have no natural dedupe key.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

/** Meta-policy-level "may we message this number at all", distinct from
 * NotificationPreference.whatsappEnabled (which assumes consent already
 * exists and only toggles which message CATEGORIES a customer wants once
 * a conversation is already permitted). Keyed by phone, not customerId,
 * since consent can be recorded before any Customer match exists (e.g. an
 * inbound message from an unrecognized number that later gets linked). */
model WhatsAppConsent {
  id          String  @id @default(cuid())
  phoneNumber String  @unique
  customerId  String? @unique
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  status String @default("UNKNOWN") // WhatsAppConsentStatus's values, stored as a string so a webhook-recorded consent for an unmatched phone number never needs a customerId

  // e.g. "customer_portal" | "whatsapp_stop_command" | "whatsapp_start_command" | "staff_recorded" | "first_inbound_message"
  source String

  consentedAt DateTime?
  optedOutAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("whatsapp_consents")
}

/** Spec #13/#43 — every provider webhook call lands here first, keyed by
 * the provider's own event id (or a payload hash when the provider gives
 * none), before any business processing runs. The unique constraint IS
 * the idempotency guarantee: a redelivered webhook fails the insert and
 * is dropped, never reprocessed. */
model WhatsAppWebhookEvent {
  id          String  @id @default(cuid())
  provider    String // "meta" | "mock"
  eventId     String
  payloadHash String

  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  status       String    @default("PENDING") // PENDING | PROCESSED | FAILED
  error        String?
  retryCount   Int       @default(0)

  @@unique([provider, eventId])
  @@index([status])
  @@map("whatsapp_webhook_events")
}

/** Phase 14 spec #7/#8 — short-lived OTP for linking a WhatsApp
 * conversation to an existing customer account before any sensitive data
 * (booking details, documents, payment info) is shown over the channel.
 * `codeHash` never stores the plaintext code — same discipline as
 * password/refresh-token hashing elsewhere in this codebase — and the
 * code itself is never written to logs or audit metadata. */
model WhatsAppOtpChallenge {
  id          String    @id @default(cuid())
  phoneNumber String
  customerId  String?
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
  @@map("whatsapp_otp_challenges")
}

// ---------------------------------------------------------------------------
// Hotel booking — same provider-abstraction / search / book / invoice shape
// as flights (see FlightBooking above and HotelProviderPort), for the
// "Domestic and international hotel stays" module.
// ---------------------------------------------------------------------------

enum HotelProviderName {
  MOCK
  CATALOG
}

enum HotelBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REFUND_REQUESTED
  REFUNDED
  CANCELLED
}

enum HotelStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum MealPlan {
  ROOM_ONLY
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

enum HotelRefundStatus {
  REQUESTED
  COMPLETED
  FAILED
  REJECTED
}

enum PackageComponentType {
  FLIGHT
  HOTEL
  VISA
  TRANSPORT
  MEALS
  INSURANCE
  TOUR
  OTHER
}

enum TravelPackageCategory {
  ECONOMY
  STANDARD
  PREMIUM
  VIP
  FAMILY
  GROUP
}

/**
 * Admin-managed hotel catalog (spec #1) — the "Manual hotel inventory"
 * branch of the provider abstraction (spec #4): CatalogHotelProviderService
 * implements the exact same HotelProviderPort as the mock/future-real
 * providers, searching these rows instead of a remote API. Same reasoning
 * as VisaService in Phase 3: a real internal catalog, not just a live
 * search pass-through.
 */
model Hotel {
  id          String  @id @default(cuid())
  name        String
  description String?

  country   String
  city      String
  address   String?
  latitude  Float?
  longitude Float?

  starRating   Int
  contactPhone String?
  contactEmail String?
  website      String?
  checkInTime  String? // "14:00"
  checkOutTime String? // "12:00"
  amenities    String[]
  images       String[]

  cancellationPolicy String?
  paymentPolicy      String?

  status HotelStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes HotelRoomType[]
  bookings  HotelBooking[]

  @@index([city])
  @@index([status])
  @@map("hotels")
}

/**
 * One bookable room product at a Hotel — cost/price live here exactly like
 * VisaService.companyCost/sellingPrice; margin is computed at read time
 * (never stored), same "never hard-coded" principle as Phase 4's flight
 * markup. Prices are per room-night; HotelsService multiplies by nights x
 * rooms at booking/search time.
 */
model HotelRoomType {
  id      String @id @default(cuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name         String // "Deluxe Double", "Executive Suite", ...
  category     String // SINGLE/DOUBLE/TWIN/TRIPLE/QUAD/SUITE/FAMILY/VIP — free text, not an enum, so a hotel can name its own categories
  description  String?
  capacity     Int
  bedType      String?
  numberOfBeds Int      @default(1)
  mealPlan     MealPlan @default(ROOM_ONLY)

  supplierCost Int // per room-night, whole currency units
  sellingPrice Int // per room-night — margin = sellingPrice - supplierCost
  currency     String @default("NGN")

  totalRooms        Int     @default(1) // simple availability count, not date-ranged inventory
  cancellationRules String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings HotelBooking[]

  @@index([hotelId])
  @@index([isActive])
  @@map("hotel_room_types")
}

model HotelBookingGuest {
  id        String       @id @default(cuid())
  bookingId String
  booking   HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Exactly one of these is set, same pattern as FlightBookingPassenger.
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("hotel_booking_guests")
}

model HotelRefund {
  id String @id @default(cuid())

  bookingId String
  booking   HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedByStaffId  String?
  requestedByStaff    Staff?  @relation("RequestedHotelRefunds", fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  requestedByCustomer Boolean @default(false)

  bookingPrice    Int
  supplierPenalty Int    @default(0)
  agencyFee       Int    @default(0)
  refundAmount    Int
  currency        String

  status HotelRefundStatus @default(REQUESTED)
  reason String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId])
  @@map("hotel_refunds")
}

/**
 * Package builder (spec #11-#14) — a staff-composed bundle of components
 * (flight/hotel/visa/transport/...), each snapshotted with its own
 * cost/price so the package total, margin, and staff incentive all derive
 * from the same numbers a customer sees, never a second guess at pricing.
 * A component optionally references an existing FlightBooking/
 * HotelBooking/VisaApplication row when one already exists (booked through
 * their own module), or stands alone as a priced line item (e.g. "Ziyarat
 * tour", "Airport transfer") when it doesn't.
 */
model TravelPackage {
  id               String @id @default(cuid())
  packageReference String @unique

  name        String
  category    TravelPackageCategory @default(STANDARD)
  description String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  hajjPackageId  String?
  umrahPackageId String?

  totalCost  Int // sum of component costs — computed at creation, snapshotted
  totalPrice Int // sum of component selling prices
  currency   String @default("NGN")

  createdByStaffId String?
  createdByStaff   Staff?  @relation("CreatedTravelPackages", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  branchId         String?
  branch           Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  isOfflineEntry Boolean @default(false)
  offlineReason  String?

  components TravelPackageComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("travel_packages")
}

model TravelPackageComponent {
  id        String        @id @default(cuid())
  packageId String
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  type        PackageComponentType
  description String

  cost  Int // internal cost for this component
  price Int // what the customer is charged for this component

  flightBookingId   String?
  hotelBookingId    String?
  visaApplicationId String?

  createdAt DateTime @default(now())

  @@index([packageId])
  @@map("travel_package_components")
}

model HotelBooking {
  id               String @id @default(cuid())
  bookingReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Set when a staff member books on the customer's behalf; null for
  // customer self-service bookings.
  bookedByStaffId String?
  bookedByStaff   Staff?  @relation(fields: [bookedByStaffId], references: [id], onDelete: SetNull)

  provider        HotelProviderName
  providerOfferId String
  providerOrderId String?
  status          HotelBookingStatus @default(PENDING)

  currency    String
  totalAmount Int // whole currency units, no minor-unit subdivision

  hotelName    String
  city         String
  country      String
  starRating   Int
  roomType     String
  checkInDate  DateTime
  checkOutDate DateTime
  rooms        Int
  guests       Int

  // Full offer snapshot as returned by the provider at booking time — same
  // reasoning as FlightBooking.itinerary.
  offerSnapshot Json

  // Set when the offer came from the internal Hotel/HotelRoomType catalog
  // (the CATALOG provider) rather than an external search provider — null
  // for a MOCK-provider booking, same nullable/optional shape as
  // FlightBooking.pricingRuleId.
  hotelId       String?
  hotel         Hotel?         @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  roomTypeId    String?
  hotelRoomType HotelRoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  // Costing snapshot — same "never recompute later" principle as every
  // other module's *Snapshot fields. Null for a MOCK-provider booking
  // (no internal cost to know), always set for a CATALOG booking.
  supplierCost Int?
  markupAmount Int?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isOfflineEntry Boolean @default(false)
  offlineReason  String?

  idempotencyKey String? @unique

  completedAt        DateTime?
  completedByStaffId String?
  completedByStaff   Staff?    @relation("CompletedHotelBookings", fields: [completedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice         Invoice?
  guestRecords    HotelBookingGuest[]
  refunds         HotelRefund[]
  roomAllocations RoomAllocation[]

  @@index([customerId])
  @@index([bookedByStaffId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@map("hotel_bookings")
}

// ---------------------------------------------------------------------------
// Vehicle rental — car, van, or bus, with or without a driver. Nigerian car
// hire is overwhelmingly chauffeur-driven, so withDriver defaults true
// rather than being an afterthought.
// ---------------------------------------------------------------------------

enum VehicleType {
  CAR
  VAN
  BUS
}

enum VehicleRentalProviderName {
  MOCK
}

enum VehicleRentalStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model VehicleRental {
  id               String @id @default(cuid())
  bookingReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  bookedByStaffId String?
  bookedByStaff   Staff?  @relation(fields: [bookedByStaffId], references: [id], onDelete: SetNull)

  provider        VehicleRentalProviderName
  providerOfferId String
  providerOrderId String?
  status          VehicleRentalStatus       @default(PENDING)

  currency    String
  totalAmount Int

  vehicleType     VehicleType
  vehicleName     String // e.g. "Toyota Camry", "Toyota Hiace (14-seater)"
  pickupCity      String
  pickupLocation  String
  dropoffLocation String
  pickupAt        DateTime
  dropoffAt       DateTime
  withDriver      Boolean     @default(true)

  offerSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice?

  @@index([customerId])
  @@index([bookedByStaffId])
  @@map("vehicle_rentals")
}

// ---------------------------------------------------------------------------
// Visa Processing — document collection + staff-tracked application status
// for a single applicant (the customer or one of their family members).
// Deliberately reuses the existing CustomerDocument/FamilyMemberDocument
// upload pipeline (DocumentType already has PASSPORT/VISA/PHOTO) instead of
// a separate upload path — an application just points at whichever
// customer/family member the documents already live under. Generates one
// Invoice for the processing fee, same shape as HotelBooking/VehicleRental.
// ---------------------------------------------------------------------------

enum VisaType {
  TOURIST
  BUSINESS
  STUDENT
  WORK
  TRANSIT
  PILGRIMAGE
  OTHER
}

enum VisaApplicationStatus {
  // Phase 2 statuses — kept exactly as-is so existing rows/history and the
  // Phase 2 own/admin controllers keep working unmodified.
  SUBMITTED
  IN_REVIEW
  ADDITIONAL_DOCUMENTS_REQUIRED
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
  // Phase 3 additions — the richer workflow VisaWorkflowService drives for
  // any application created against a VisaService (the catalog). Appended
  // rather than replacing the Phase 2 set for the same reason DocumentType
  // was appended to above: Postgres enum values are cheap to add, risky to
  // remove or reorder.
  DRAFT
  AWAITING_DOCUMENTS
  AWAITING_GUARANTOR
  GUARANTOR_VERIFICATION
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  UNDER_REVIEW
  SUBMITTED_TO_PROVIDER
  PROCESSING
  ADDITIONAL_INFO_REQUIRED
  COMPLETED
  // Phase 9 — an issued visa whose expiryDate (see VisaApplication) has
  // passed; set by the expiry-tracking sweep (VisaOpsAutomationService),
  // never by staff directly. Appended, same reasoning as every other enum
  // extension in this file.
  EXPIRED
}

enum VisaServiceStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

/**
 * The visa "product catalog" — what Phase 3 adds on top of Phase 2's
 * free-text destinationCountry/visaType. A VisaApplication may optionally
 * point at one of these (visaServiceId); when it does, companyCost/
 * sellingPrice/margin are snapshotted onto the application at submission
 * time (see VisaApplicationsService.submit) so later catalog price changes
 * never retroactively alter an already-submitted application's numbers —
 * same "snapshot what was actually agreed" principle as
 * FlightBooking.itinerary or HotelBooking.offerSnapshot.
 * margin is deliberately NOT a stored column — it's always
 * `sellingPrice - companyCost`, computed wherever it's needed (API
 * responses, reports), the same "the source of truth is the inputs, not a
 * cached derivation" principle as Wallet's computed-on-read balance.
 */
model VisaService {
  id          String @id @default(cuid())
  serviceCode String @unique // e.g. "VS-UK-TOURIST-001"

  country      String
  visaType     String // free-text, not the VisaType enum — the real world has far more visa categories than that fixed set covers
  visaCategory String?
  description  String?

  processingTime    String? // free-text, e.g. "10-15 business days"
  validityPeriod    String? // free-text, e.g. "90 days, single entry"
  entryType         String? // e.g. "Single", "Multiple"
  requiredDocuments String? // free-text list, same pattern as HajjPackage.requiredDocuments

  supplierName String?
  supplierCost Int? // what the supplier/embassy/agent charges Alnajoum, whole currency units
  companyCost  Int // Alnajoum's all-in cost (>= supplierCost when set) — what margin is computed against
  sellingPrice Int // what the customer is charged
  currency     String  @default("NGN")

  processingFee Int @default(0) // Alnajoum's own service fee, separate from companyCost/sellingPrice
  otherFees     Int @default(0)

  incentivePolicyId String?
  incentivePolicy   IncentivePolicy? @relation(fields: [incentivePolicyId], references: [id], onDelete: SetNull)

  termsAndConditions String?
  isAvailable        Boolean           @default(true)
  status             VisaServiceStatus @default(DRAFT)

  // The "business configuration requires a guarantor" switch (spec #6) —
  // defaults true since most visa types in this business genuinely need
  // one; an admin can turn it off per service (e.g. a low-risk transit
  // visa). A staff-recorded exemption on a specific application
  // (VisaApplication.guarantorExempt) can still override this per-case —
  // see VisaService.isGuarantorRequired() in visa.service.ts.
  requiresGuarantor Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications VisaApplication[]

  @@index([status])
  @@index([country])
  @@map("visa_services")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * A guarantor/sponsor vouching for an applicant — required by
 * VisaWorkflowService.isGuarantorRequired() unless the applicant is staff
 * or the service is configured as exempt. One guarantor is scoped to one
 * application (not reused across applications) since the responsibility
 * being accepted is specific to that trip.
 */
model Guarantor {
  id String @id @default(cuid())

  fullName     String
  phone        String
  whatsapp     String?
  email        String?
  address      String?
  relationship String // e.g. "Parent", "Employer", "Sibling", "Friend"

  idType   String?
  idNumber String?

  verificationStatus VerificationStatus @default(PENDING)
  approvalStatus     ApprovalStatus     @default(PENDING)

  // Set once the guarantor has confirmed (via the link sent to them, or
  // recorded by staff on their behalf) that they accept the responsibility
  // the business workflow requires of them.
  acceptedResponsibilityAt DateTime?

  verifiedByStaffId String?
  verifiedByStaff   Staff?  @relation(fields: [verifiedByStaffId], references: [id], onDelete: SetNull)
  verificationNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application VisaApplication?
  documents   VisaDocument[]

  @@map("guarantors")
}

enum VisaDocumentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

/**
 * A document attached to a specific visa application (or, when
 * guarantorId is set instead, to a guarantor) — distinct from the older
 * CustomerDocument/FamilyMemberDocument (which live on the profile, not
 * tied to one application) because Phase 3 needs per-application
 * verification status and expiry tracking that a profile-level document
 * doesn't have. Exactly one of applicationId/guarantorId is set,
 * enforced in VisaDocumentsService rather than at the DB level (Prisma
 * has no CHECK-constraint escape hatch here).
 */
model VisaDocument {
  id String @id @default(cuid())

  applicationId String?
  application   VisaApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  guarantorId String?
  guarantor   Guarantor? @relation(fields: [guarantorId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedByIdentityId String?
  expiryDate           DateTime?

  status            VisaDocumentStatus @default(PENDING_REVIEW)
  reviewedByStaffId String?
  reviewedByStaff   Staff?             @relation(fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewNote        String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([guarantorId])
  @@index([status])
  @@map("visa_documents")
}

/**
 * Staff-only internal note thread on an application — "Add internal
 * notes" from the spec, kept as an append-only list (like AuditLog)
 * rather than a single overwritable field so the review history is never
 * lost.
 */
model VisaApplicationNote {
  id            String          @id @default(cuid())
  applicationId String
  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  note String

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("visa_application_notes")
}

model VisaApplication {
  id                   String @id @default(cuid())
  applicationReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Exactly one applicant per application — set when it's for a family
  // member rather than the customer themself, same shape as
  // FlightBookingPassenger/HajjRegistrationPilgrim.
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  // Set when a staff member submits on the customer's behalf; null for
  // customer self-service submissions.
  appliedByStaffId String?
  appliedByStaff   Staff?  @relation(fields: [appliedByStaffId], references: [id], onDelete: SetNull)

  // The visa officer currently responsible for this application — distinct
  // from appliedByStaffId (who submitted it, often a different person from
  // whoever processes it). Set via VisaWorkflowService.assign(), gated by
  // the visa:assign permission.
  assignedStaffId String?
  assignedStaff   Staff?  @relation("AssignedVisaApplications", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  destinationCountry String
  visaType           VisaType
  intendedTravelDate DateTime?

  // Snapshot of who the application is for, independent of later profile edits.
  applicantFirstName      String
  applicantLastName       String
  applicantPassportNumber String?

  status    VisaApplicationStatus @default(SUBMITTED)
  // Latest staff-visible note — what's missing, why it was rejected, etc.
  // Phase 1 tracks only the current status + note (like HotelBooking/
  // VehicleRental's single `status` column); a full transition history would
  // be a natural follow-up once this is in real use.
  staffNote String?

  currency    String
  totalAmount Int // processing fee, whole currency units — see VISA_PROCESSING_FEES

  notes String? // free-text from the applicant at submission time

  // --- Phase 3 additions, all nullable so Phase 2 applications (created
  // without a catalog service) remain perfectly valid rows. ---

  visaServiceId String?
  visaService   VisaService? @relation(fields: [visaServiceId], references: [id], onDelete: SetNull)

  // Snapshotted from VisaService at submission time — see VisaService's
  // own doc comment for why these aren't just re-read from the catalog.
  companyCostSnapshot  Int?
  sellingPriceSnapshot Int?

  guarantorId           String?    @unique
  guarantor             Guarantor? @relation(fields: [guarantorId], references: [id], onDelete: SetNull)
  guarantorRequired     Boolean    @default(false)
  // A staff-authorized exemption from an otherwise-required guarantor
  // (e.g. the applicant is a known staff member or VIP) — never
  // settable by the customer themselves; always audited when set (see
  // VisaService.submit()).
  guarantorExempt       Boolean    @default(false)
  guarantorExemptReason String?

  previousVisaInfo String? // free-text: prior visas held, refusals, etc.
  contactPhone     String?
  contactEmail     String?

  isOfflineEntry Boolean @default(false)
  offlineReason  String?

  // --- Phase 9 additions — all nullable/defaulted so every existing row
  // stays valid without a backfill. ---

  // Snapshotted from CountryVisaRule at submission time (same "never let a
  // later config change retroactively alter an already-submitted
  // application" principle as companyCostSnapshot above) — the number of
  // days used to compute slaDueAt below.
  slaTargetDays Int?
  // Set once the application enters UNDER_REVIEW (see VisaApplicationsService
  // / VisaSlaService) — "expected completion", same shape as
  // SupportTicket.slaResponseDueAt from Phase 7.
  slaDueAt      DateTime?

  // Spec #26 — set once a visa is actually issued (VisaSubmissionsService
  // records these from the provider's/embassy's response, never guessed).
  issueDate        DateTime?
  expiryDate       DateTime?
  entryValidity    String? // e.g. "Single entry", "Multiple entry"
  stayDurationDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice             Invoice?
  notesLog            VisaApplicationNote[]
  documents           VisaDocument[]
  submissions         VisaSubmission[]
  providerMessages    VisaProviderMessage[]
  checklistExceptions DocumentChecklistException[]
  refund              VisaRefund?
  // Linked to StaffIncentive by sourceType "VISA_APPLICATION" + sourceId —
  // a polymorphic reference (not a Prisma relation) matching how
  // HAJJ_REGISTRATION/UMRAH_REGISTRATION incentives already work; see
  // VisaIncentivesService.

  @@index([customerId])
  @@index([familyMemberId])
  @@index([status])
  @@index([visaServiceId])
  @@index([assignedStaffId])
  @@map("visa_applications")
}

// ---------------------------------------------------------------------------
// Phase 9 — enterprise visa & immigration operations, built on top of
// everything above rather than beside it:
//   - A "visa type" stays whatever free-text string VisaService.visaType
//     already accepts — CountryVisaRule keys off the same string, no new
//     enum, no hard-coded per-country logic anywhere in code.
//   - The document checklist (spec #9) is computed live from
//     CountryVisaRule + the existing CustomerDocument/FamilyMemberDocument/
//     VisaDocument tables — never a stored, driftable copy — same
//     discipline as Customer360Service.segments() in Phase 7.
//   - Guarantor, payment, and incentive logic are untouched; Phase 9 only
//     adds the provider-submission and refund pieces that were genuinely
//     missing, reusing FinancePostingService.postRefund/
//     cancelIncentivesForSource exactly as HotelRefundsService does.
// ---------------------------------------------------------------------------

/**
 * Per-country (optionally per-visa-type) configurable requirements —
 * spec #4. A row with visaType = "" (sentinel, not null) is that country's
 * fallback/default rule; a row with visaType set overrides it for that
 * specific type. CountryVisaRulesService.getApplicableRule() picks the more
 * specific one. Deliberately not nullable: Postgres treats every NULL as
 * distinct from every other NULL, so a nullable visaType would let staff
 * create multiple "default" rows per country despite the @@unique below.
 */
model CountryVisaRule {
  id       String @id @default(cuid())
  country  String
  // Matches VisaApplication.visaType's actual stored convention — always
  // one of the VisaType enum's literal values (e.g. "PILGRIMAGE",
  // "TOURIST"), since VisaService.submit() writes dto.visaType (the enum)
  // straight into that free-text column. NOT VisaService (the catalog
  // model)'s own separate, differently-cased visaType convention (e.g.
  // "Pilgrimage") — getApplicableRule() is looked up against the
  // application, so this must key on the same values it holds.
  visaType String @default("") // "" = applies to every type for this country

  requiredDocumentTypes DocumentType[]
  optionalDocumentTypes DocumentType[]

  minPassportValidityMonths Int? // spec #11 — never a hard-coded universal rule
  photoRequirements         String?
  guarantorRequired         Boolean @default(false)

  processingTimeDays  Int? // default SLA target (spec #30) unless a VisaService overrides it
  appointmentRequired Boolean @default(false)
  insuranceRequired   Boolean @default(false)

  feeAmount   Int? // informational default — VisaService pricing is still what's actually charged
  feeCurrency String?

  restrictions String?
  notes        String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, visaType])
  @@index([country])
  @@map("country_visa_rules")
}

/**
 * Spec #9's "allow authorized administrators to configure exceptions" —
 * an audited, reasoned override letting a specific application submit
 * despite a missing mandatory document, without weakening the checklist
 * rule for every other application of the same type.
 */
model DocumentChecklistException {
  id            String          @id @default(cuid())
  applicationId String
  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentType DocumentType
  reason       String

  approvedByStaffId String
  approvedByStaff   Staff  @relation(fields: [approvedByStaffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([applicationId, documentType])
  @@index([applicationId])
  @@map("document_checklist_exceptions")
}

enum VisaProviderName {
  MANUAL // staff record what an embassy/agent/visa center told them — no API
  MOCK // deterministic simulated provider for localhost/demo/tests
}

/**
 * Spec #14 — the actual "submitted to the provider" event, distinct from a
 * staff member merely clicking a status dropdown. One row per submission
 * attempt (a resubmission after ADDITIONAL_INFO_REQUIRED creates a new
 * row, preserving history rather than overwriting it).
 */
model VisaSubmission {
  id            String          @id @default(cuid())
  applicationId String
  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  submittedByStaffId String
  submittedByStaff   Staff  @relation(fields: [submittedByStaffId], references: [id], onDelete: Restrict)

  provider          VisaProviderName
  externalReference String?
  // The provider's own status vocabulary, kept verbatim and separate from
  // VisaApplication.status — spec #16: "do not blindly overwrite internal
  // statuses... record provider status separately where necessary".
  providerStatus    String?
  providerMessage   String?

  documentsSubmitted Json? // snapshot of which VisaDocument ids/types went out, for the record
  submissionNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("visa_submissions")
}

enum ProviderMessageSeverity {
  INFO
  WARNING
  ACTION_REQUIRED
}

/**
 * Spec #17 — provider/visa-center messages surfaced to authorized staff, independent of the raw providerStatus string on VisaSubmission.
 */
model VisaProviderMessage {
  id            String          @id @default(cuid())
  applicationId String
  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  message  String
  severity ProviderMessageSeverity @default(INFO)

  acknowledgedByStaffId String?
  acknowledgedByStaff   Staff?    @relation(fields: [acknowledgedByStaffId], references: [id], onDelete: SetNull)
  acknowledgedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("visa_provider_messages")
}

enum VisaRefundStatus {
  REQUESTED
  COMPLETED
  FAILED
  REJECTED
}

/**
 * Spec #23 — mirrors HotelRefund's exact shape and calculation
 * (refundAmount = amountPaid − supplierPenalty − agencyFee); posts through
 * the same FinancePostingService.postRefund/cancelIncentivesForSource used
 * by hotel/flight refunds rather than a new finance code path.
 */
model VisaRefund {
  id            String          @id @default(cuid())
  applicationId String          @unique
  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  requestedByStaffId  String?
  requestedByStaff    Staff?  @relation(fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  requestedByCustomer Boolean @default(false)

  amountPaid      Int
  supplierPenalty Int    @default(0)
  agencyFee       Int    @default(0)
  refundAmount    Int
  currency        String

  status VisaRefundStatus @default(REQUESTED)
  reason String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("visa_refunds")
}

// ---------------------------------------------------------------------------
// Corporate Travel — staff-managed booking on behalf of a corporate client's
// traveling employees, with one consolidated Invoice (one InvoiceLineItem
// per traveler) covering the whole trip. Staff-only: corporate clients don't
// get a customer portal login in this phase — "company-level booking on
// behalf of staff travelers" is literally staff creating and managing these
// on the client's behalf, reusing the existing Staff/Branch structure
// (managedBranchId, bookedByStaffId) rather than inventing a parallel one.
// ---------------------------------------------------------------------------

enum CorporateBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model CorporateAccount {
  id   String @id @default(cuid())
  name String

  registrationNumber String?
  billingEmail       String?
  billingPhone       String?
  billingAddress     String?
  contactPersonName  String?

  // Which Alnajoum branch manages this account — what "consolidated
  // invoicing ... per branch" groups by in the admin view, alongside "per
  // company" (i.e. per CorporateAccount) grouping.
  managedBranchId String?
  managedBranch   Branch? @relation(fields: [managedBranchId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  // Phase 10 spec #21 — corporate travel policy, enforced by
  // FlightsService.enforceCorporatePolicy whenever a flight booking links
  // to this account. Every field is optional/empty-means-unrestricted,
  // same "no rule configured = nothing blocks it" discipline as
  // CountryVisaRule — a corporate account with no policy set behaves
  // exactly as before this phase.
  creditLimit         Int? // outstanding CorporateBooking total this account may carry before requiring approval
  maxFareAmount       Int? // no single flight booking on this account may exceed this, in `maxFareCurrency`
  maxFareCurrency     String?
  allowedCabinClasses CabinClass[] // empty = every cabin allowed
  preferredAirlines   String[] // IATA codes; empty = no preference enforced
  requiresApproval    Boolean      @default(false) // every booking on this account needs staff sign-off (FlightBooking.corporateApprovalStatus) before ticketing — same ad-hoc per-module approval pattern as ManualPaymentSubmission/Guarantor, no shared approval-engine exists in this codebase
  advanceBookingDays  Int? // minimum days before departure a booking must be made

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelers      CorporateTraveler[]
  bookings       CorporateBooking[]
  flightBookings FlightBooking[]

  @@index([managedBranchId])
  @@map("corporate_accounts")
}

model CorporateTraveler {
  id                 String           @id @default(cuid())
  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  email          String?
  phone          String?
  department     String?
  passportNumber String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingLines CorporateBookingTraveler[]

  @@index([corporateAccountId])
  @@map("corporate_travelers")
}

model CorporateBooking {
  id               String @id @default(cuid())
  bookingReference String @unique

  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Restrict)

  bookedByStaffId String
  bookedByStaff   Staff  @relation(fields: [bookedByStaffId], references: [id], onDelete: Restrict)

  // Free-text description of the trip as a whole, e.g. "Lagos–Abuja return
  // flights, 12–15 Sept, 3 staff" — corporate bookings aggregate travelers
  // and amounts rather than searching a live provider offer, since what's
  // actually being booked (flights, hotels, ground transport, or a mix) is
  // arranged per traveler and only the consolidated total/invoice needs to
  // be structured data.
  description String
  status      CorporateBookingStatus @default(PENDING)

  currency    String
  totalAmount Int // sum of traveler line amounts, snapshotted at creation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelers CorporateBookingTraveler[]
  invoice   Invoice?

  @@index([corporateAccountId])
  @@index([bookedByStaffId])
  @@index([status])
  @@map("corporate_bookings")
}

model CorporateBookingTraveler {
  id        String           @id @default(cuid())
  bookingId String
  booking   CorporateBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  travelerId String
  traveler   CorporateTraveler @relation(fields: [travelerId], references: [id], onDelete: Restrict)

  // e.g. "Return flight LOS-ABV" — one consolidated-invoice line item per
  // traveler, snapshotted at booking time.
  description String
  amount      Int

  @@index([bookingId])
  @@index([travelerId])
  @@map("corporate_booking_travelers")
}

// ---------------------------------------------------------------------------
// Phase 6 — Enterprise finance: chart of accounts, double-entry ledger,
// expenses, supplier payables, company investment, daily closing, bank
// reconciliation. Every module that already moves money (payments, wallet,
// incentives/payouts, refunds) posts INTO this ledger through LedgerService
// rather than getting its own parallel accounting — see finance.module.ts.
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

/**
 * One line of the chart of accounts (spec #2). `code` is what application
 * code posts against — FinanceConstants.SYSTEM_ACCOUNT_CODES — so a system
 * account's `code` must never be reassigned once seeded, the same rule this
 * codebase already applies to RBAC permission keys. isSystem just prevents
 * deleting/retyping one from the admin screen; an admin can still freely
 * create additional non-system accounts (e.g. a new expense category).
 */
model LedgerAccount {
  id   String      @id @default(cuid())
  code String      @unique
  name String
  type AccountType

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  // Null = a company-wide account (the overwhelming majority — cash,
  // receivables, most revenue/expense lines). Set only when a report needs
  // to slice one account per branch (spec #21's branch accounting), which
  // this phase doesn't do by default to avoid needlessly fragmenting the
  // chart of accounts — BranchAccountingService derives per-branch
  // revenue/expense from the source records' own branchId instead.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debitEntries  JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")
  expenses      Expense[]

  @@index([type])
  @@map("ledger_accounts")
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

/**
 * The double-entry ledger (spec #3). Deliberately a debit-account/
 * credit-account *pair* per row rather than an N-line journal — the spec's
 * own field list ("Debit account, Credit account, Amount...") describes
 * exactly this shape, and it makes an unbalanced entry structurally
 * impossible: there is no sum-of-debits-equals-sum-of-credits invariant to
 * validate, because every row already debits one account and credits
 * another by the same `amount`. A business event that touches more than two
 * accounts (rare in this system) simply posts more than one JournalEntry
 * sharing the same `reference`.
 * Append-only: POSTED entries are never edited or deleted (spec #3's "never
 * permanently delete posted financial transactions"). A correction posts a
 * new entry with accounts swapped and links back via reversalOfId — see
 * LedgerService.reverseEntry().
 */
model JournalEntry {
  id String @id @default(cuid())

  debitAccountId  String
  debitAccount    LedgerAccount @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId String
  creditAccount   LedgerAccount @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  amount   Int // whole currency units, always positive — direction is which account is debit vs credit
  currency String

  // Groups related legs of one business event (e.g. all entries posted for
  // one Payment share its paymentReference) — not unique by itself, unlike
  // Payment.paymentReference.
  reference   String
  description String

  // "PAYMENT" | "WALLET" | "INCENTIVE" | "PAYOUT" | "REFUND" | "EXPENSE" |
  // "INVESTMENT" | "SUPPLIER_PAYMENT" | "MANUAL" — which module's code
  // called LedgerService.post(), for filtering and for
  // ProfitAndLossService/CashFlowService to know how to bucket a row.
  sourceModule String
  sourceId     String?

  status JournalEntryStatus @default(POSTED)

  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy   JournalEntry? @relation("Reversal")

  createdByIdentityId String?
  createdByIdentity   Identity? @relation(fields: [createdByIdentityId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([sourceModule, sourceId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@map("journal_entries")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

/**
 * Spec #19. Only an APPROVED expense that's been marked PAID posts a ledger
 * entry (debit the chosen expense account, credit Cash/Bank) — see
 * ExpensesService.approve()/markPaid(), mirroring how a ManualPaymentSubmission
 * has zero ledger effect until approved.
 */
model Expense {
  id            String @id @default(cuid())
  expenseNumber String @unique

  category    String
  amount      Int
  currency    String
  date        DateTime
  description String
  vendor      String?

  paymentMethod       PaymentMethod?
  receiptDocumentPath String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  accountId String?
  account   LedgerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  status ExpenseStatus @default(PENDING)

  createdByStaffId String
  createdByStaff   Staff  @relation("CreatedExpenses", fields: [createdByStaffId], references: [id], onDelete: Restrict)

  approvedByStaffId String?
  approvedByStaff   Staff?    @relation("ApprovedExpenses", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  rejectionReason   String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([category])
  @@map("expenses")
}

enum InvestmentType {
  INITIAL
  ADDITIONAL
  WITHDRAWAL
}

/**
 * Spec #15/#16: equity, never revenue. WITHDRAWAL (an owner draw) is its own
 * type rather than an Expense — reduces equity directly, distinct from an
 * operating expense, per spec #16's explicit warning not to conflate the two.
 */
model CompanyInvestment {
  id String @id @default(cuid())

  type        InvestmentType
  amount      Int
  currency    String
  investor    String
  date        DateTime
  description String?
  reference   String?

  recordedByIdentityId String?
  recordedByIdentity   Identity? @relation(fields: [recordedByIdentityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([type])
  @@map("company_investments")
}

enum SupplierPayableStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

/**
 * Spec #20. One row per booking's supplier cost obligation — created
 * automatically when a flight is ticketed / hotel booking is completed /
 * visa application's company cost is set (see SupplierPayablesService.
 * createFromBooking(), called from the existing ticketing/completion flows
 * rather than duplicating their cost-snapshot logic).
 */
model SupplierPayable {
  id String @id @default(cuid())

  // Phase 11 spec #2/#65 fix — resolved from the source booking's customer
  // at creation time (see FinancePostingService.postCostOfServiceForBooking)
  // rather than joined through sourceModule/sourceId at read time, since
  // that pointer is polymorphic and Prisma can't express a relation-based
  // filter across three different target tables. Kept even when
  // flightSupplierId also resolves to a company — this is the company that
  // owes the money (the booking's), which is what actually matters here.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  supplierName String
  sourceModule String // "FLIGHT_BOOKING" | "HOTEL_BOOKING" | "VISA_APPLICATION"
  sourceId     String

  // Phase 10 — links this payable to a FlightSupplier master record when
  // one exists for `supplierName`, so FlightSuppliersService.getBalance()
  // can compute a real per-supplier exposure. Null for every payable that
  // predates this phase or belongs to a supplier with no master record yet
  // (Hotel/Visa suppliers, or a flight supplier not yet onboarded) — the
  // existing supplierName free-text keeps working exactly as before.
  flightSupplierId String?
  flightSupplier   FlightSupplier? @relation(fields: [flightSupplierId], references: [id], onDelete: SetNull)

  // Phase 16 — same best-effort-link-by-name pattern as flightSupplierId
  // above, against the new domain-agnostic Supplier model instead (for
  // Hotel/Visa/Hajj/Umrah payables, which have never had a master record
  // to link to until now — see Supplier's own doc comment). A payable can
  // have at most one of flightSupplierId/supplierId populated in
  // practice (FinancePostingService only searches FlightSupplier for a
  // FLIGHT_BOOKING payable), but both stay independently nullable rather
  // than one excluding the other at the schema level, since nothing
  // requires that today.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  amount     Int
  currency   String
  amountPaid Int    @default(0)

  dueDate DateTime?
  status  SupplierPayableStatus @default(OUTSTANDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SupplierPayment[]

  @@index([status])
  @@index([companyId])
  @@index([sourceModule, sourceId])
  @@index([flightSupplierId])
  @@index([supplierId])
  @@map("supplier_payables")
}

model SupplierPayment {
  id String @id @default(cuid())

  payableId String
  payable   SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)

  amount        Int
  currency      String
  paymentMethod PaymentMethod
  reference     String?
  note          String?

  recordedByStaffId String
  recordedByStaff   Staff  @relation(fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  paidAt DateTime @default(now())

  @@index([payableId])
  @@map("supplier_payments")
}

// ============================================================================
// Phase 16 — Enterprise Supplier Marketplace foundation.
//
// FlightSupplier/FlightSupplierContract (above) already fully cover flight
// commercial-supplier management (Phase 10/11) — this is NOT a replacement
// or migration of that model, and flights keep using it exactly as before.
// This is the domain-agnostic supplier master record that Hotel/Visa/Hajj/
// Umrah have never had (SupplierPayable.supplierName has been free-text-only
// for those domains since Phase 11 — see that model's own comment). Every
// design choice here (tenant-scoped, contract versioned separately from the
// supplier row, balance computed live from SupplierPayable rather than
// stored) deliberately mirrors FlightSupplier's already-proven shape.
// ============================================================================

enum SupplierType {
  AIRLINE
  GDS
  FLIGHT_CONSOLIDATOR
  HOTEL
  HOTEL_WHOLESALER
  VISA_PROVIDER
  HAJJ_SUPPLIER
  UMRAH_SUPPLIER
  TRANSPORT_COMPANY
  BUS_OPERATOR
  CAR_RENTAL
  ACTIVITY_PROVIDER
  TOUR_OPERATOR
  INSURANCE_PROVIDER
  TICKET_CONSOLIDATOR
  GROUND_HANDLER
  LOCAL_PARTNER
  OTHER
}

// Spec #3's onboarding workflow, modeled as a single status column rather
// than a separate "application" table — SuppliersService enforces the
// forward-only transition order (with SUSPENDED/TERMINATED reachable from
// ACTIVE, and REACTIVATED going back to ACTIVE from SUSPENDED), same
// "status column + a service method that validates the transition" pattern
// as FlightSupplierContractStatus/InvoiceStatus elsewhere in this schema.
enum SupplierOnboardingStatus {
  DRAFT
  INVITED
  INFORMATION_SUBMITTED
  KYC_REVIEW
  DOCUMENT_REVIEW
  COMMERCIAL_REVIEW
  FINANCE_REVIEW
  ADMIN_APPROVAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum SupplierKycStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
  REJECTED
}

enum SupplierRiskStatus {
  LOW
  MEDIUM
  HIGH
}

model Supplier {
  id String @id @default(cuid())

  // Same tenant-isolation reasoning as FlightSupplier — a supplier's
  // negotiated terms are commercially sensitive per-tenant data.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  legalName   String
  tradingName String?
  type        SupplierType

  registrationNumber String?
  country            String?
  address            String?
  website            String?

  email String?
  phone String?

  currency           String  @default("NGN")
  settlementCurrency String?
  paymentTerms       String? // free text, e.g. "Net 30" — same convention as FlightSupplier.paymentTerms
  settlementCycle    String?
  creditLimit        Int?
  depositRequired    Int?

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  taxIdentificationNumber String?

  onboardingStatus SupplierOnboardingStatus @default(DRAFT)
  kycStatus        SupplierKycStatus        @default(NOT_STARTED)
  riskStatus       SupplierRiskStatus       @default(LOW)

  accountManagerStaffId String?
  accountManagerStaff   Staff?  @relation("SupplierAccountManager", fields: [accountManagerStaffId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts  SupplierContact[]
  documents SupplierDocument[]
  contracts SupplierContract[]
  payables  SupplierPayable[]

  // Phase 16 spec #6/#11/#12 — deliberately does NOT link directly to
  // Hotel/VisaService/HajjPackage/UmrahPackage. Those are platform-wide
  // catalogs with no companyId of their own (see Hotel's own doc comment:
  // "Admin-managed hotel catalog... same reasoning as VisaService" — the
  // same is true of HajjPackage/UmrahPackage), while a Supplier is
  // correctly tenant-scoped exactly like FlightSupplier. Linking a
  // shared, cross-tenant catalog row to one specific company's supplier
  // would misattribute that supplier's negotiated cost to every other
  // company selling the same catalog item. The safe, already-tenant-
  // correct linkage point is SupplierPayable.supplierId above, since a
  // payable is always created against a specific tenant-scoped booking.
  @@index([companyId])
  @@index([type])
  @@index([onboardingStatus])
  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierDocument {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  label    String // e.g. "Certificate of Incorporation", "Bank Verification Letter"
  fileUrl  String // path under the existing document-storage abstraction (see document-storage.util.ts) — not a raw filesystem path
  mimeType String

  expiresAt DateTime? // spec #34's contract-expiry-alert follow-up reads this; not itself alerted on in this increment

  uploadedByStaffId String?
  uploadedByStaff   Staff?  @relation(fields: [uploadedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_documents")
}

enum SupplierContractStatus {
  DRAFT
  NEGOTIATION
  PENDING_APPROVAL
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
}

/**
 * Versioned separately from Supplier's own fields, same reasoning as
 * FlightSupplierContract's doc comment: a supplier can have several
 * contracts over time, and renegotiating one must never overwrite the
 * historical commercial terms of the last one.
 */
model SupplierContract {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  contractNumber String @unique
  name           String
  startDate      DateTime
  endDate        DateTime?
  currency       String    @default("NGN")

  paymentTerms      String?
  creditTerms       String?
  commissionPercent Float?
  rebatePercent     Float?
  markupPercent     Float?

  settlementCycle        String?
  cancellationConditions String?
  amendmentConditions    String?

  documentUrl String? // path under the existing document-storage abstraction

  status SupplierContractStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("supplier_contracts")
}

enum DailyClosingStatus {
  OPEN
  CLOSED
}

/**
 * Spec #22. `summary` freezes the day's totals (cash/bank/online payments,
 * wallet movement, refunds, expenses, payouts, supplier payments) at close
 * time — DailyClosingService computes it fresh from the ledger and other
 * tables, then stores the snapshot rather than leaving it to be recomputed
 * (and silently drift) later. A closed day isn't literally read-only at the
 * database level (nothing in this codebase enforces that), but every
 * finance screen that lets you backdate/edit a financial record checks
 * DailyClosingService.isDateClosed() first and requires an explicit reversal
 * entry instead — see spec #22's "changes require authorized correction/
 * reversal" and LedgerService.reverseEntry().
 */
model DailyClosing {
  id String @id @default(cuid())

  businessDate DateTime @unique
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  summary Json

  closedByStaffId String
  closedByStaff   Staff    @relation(fields: [closedByStaffId], references: [id], onDelete: Restrict)
  closedAt        DateTime @default(now())

  status DailyClosingStatus @default(CLOSED)

  @@index([businessDate])
  @@map("daily_closings")
}

/**
 * Singleton (id is always "default") — configurable payout approval
 * thresholds (spec #14). tier1Max is the ceiling a Finance Officer alone
 * can approve; between tier1Max and tier2Max additionally requires
 * FINANCE.APPROVE_HIGH_VALUE (Company Admin+); above tier2Max additionally
 * requires FINANCE.APPROVE_EXECUTIVE (Super Admin) — enforced in
 * VisaIncentivesService.approve() against the acting identity's permission
 * set, not a separate dual-signature workflow (a genuine simplification
 * from the spec's "multiple approvals" language — see the Phase 6 QA
 * report's Known Limitations).
 */
model FinanceSettings {
  id String @id @default("default")

  payoutApprovalTier1Max Int @default(100000)
  payoutApprovalTier2Max Int @default(500000)

  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/**
 * Spec #23. Lines can be entered manually (localhost / no bank-feed
 * integration exists yet) or imported from a CSV export of a bank
 * statement — either way they land here as UNMATCHED and Finance works
 * through them via BankReconciliationService.match()/ignore().
 */
model BankStatementLine {
  id String @id @default(cuid())

  date              DateTime
  description       String
  amount            Int // signed: positive = inflow, negative = outflow
  currency          String
  externalReference String?

  status BankStatementLineStatus @default(UNMATCHED)

  // "PAYMENT" | "EXPENSE" | "SUPPLIER_PAYMENT" | "STAFF_PAYOUT" — loose
  // match, same free-form pattern as WalletTransaction.invoiceId.
  matchedType String?
  matchedId   String?

  importedByStaffId String?
  importedByStaff   Staff?  @relation(fields: [importedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
  @@map("bank_statement_lines")
}

// ---------------------------------------------------------------------------
// Phase 7 — Enterprise CRM, customer support, communication & task management.
// Reuses everything already built rather than duplicating it: Customer
// already carries assignedStaffId/assignedBranchId (used here for both
// customers and, via its own copy, leads); NotificationsService/
// NotificationProviderPort already IS the email/SMS/WhatsApp abstraction
// spec #15/#17 ask for (MockNotificationProviderService already satisfies
// spec #36's "testable without real credentials, logs would-be sends");
// AuditService remains the system-action log — CustomerTimelineEvent below
// is deliberately a separate, customer-facing subset of "important events"
// rather than a duplicate of it.
// ---------------------------------------------------------------------------

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
  SOCIAL_MEDIA
  REFERRAL
  STAFF
  ADVERTISEMENT
  MANUAL_ENTRY
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadStatus {
  OPEN
  CONVERTED
  LOST
}

/**
 * Configurable pipeline stages (spec #5) — an admin-managed ordered list,
 * not a hardcoded enum, since "administrators can create additional
 * stages" is explicit. Seeded with the spec's own 7 default stages (see
 * LeadsService.ensureDefaultStages(), idempotent like
 * LedgerService.ensureSystemAccounts()).
 */
model LeadStage {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)
  isActive Boolean @default(true)

  leads Lead[]

  @@map("lead_stages")
}

model Lead {
  id         String @id @default(cuid())
  leadNumber String @unique

  name  String
  phone String
  email String?

  source            LeadSource
  interestedService String?
  destination       String?
  budget            Int?
  currency          String     @default("NGN")

  stageId  String
  stage    LeadStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  status   LeadStatus   @default(OPEN)
  priority LeadPriority @default(NORMAL)

  assignedStaffId  String?
  assignedStaff    Staff?  @relation("AssignedLeads", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedBranchId String?
  assignedBranch   Branch? @relation(fields: [assignedBranchId], references: [id], onDelete: SetNull)

  notes        String?
  followUpDate DateTime?

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Set once converted — spec #6's "do not create duplicate customer
  // records" / "preserve the lead history": the Lead row is never deleted
  // on conversion, only linked forward.
  // Deliberately NOT @unique: two separate leads (e.g. two enquiries months
  // apart) can both turn out to be the same real person and both get
  // linked to the one deduplicated Customer they resolve to — spec #6's
  // "do not create duplicate customer records" is enforced by
  // LeadsService.convert()'s phone/email lookup, not by a DB constraint
  // that would wrongly forbid a second lead from ever reusing that customer.
  convertedCustomerId String?
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedAt         DateTime?
  lostReason          String?

  createdByStaffId String?
  createdByStaff   Staff?  @relation("CreatedLeads", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  tasks      Task[]

  @@index([stageId])
  @@index([status])
  @@index([assignedStaffId])
  @@index([campaignId])
  @@map("leads")
}

/**
 * Stage-change / contact-attempt history — spec #6's "preserve the lead history" in practice.
 */
model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  action      String // "stage_changed" | "note_added" | "assigned" | "converted" | "lost" | "contacted"
  description String
  fromStageId String?
  toStageId   String?

  performedByStaffId String?
  performedByStaff   Staff?  @relation(fields: [performedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskRelatedType {
  FOLLOW_UP
  VISA
  FLIGHT
  HOTEL
  HAJJ
  UMRAH
  PAYMENT
  CUSTOMER
  GUARANTOR
  DOCUMENT
  LEAD
  SUPPORT_TICKET
  OTHER
}

/**
 * One Task model covers both spec #7 (Follow-Up System) and spec #8 (Staff
 * Task Management) — a follow-up IS a Task with relatedType FOLLOW_UP,
 * rather than two parallel systems sharing the same staff/due-date/status/
 * priority shape. Spec #9 lists what auto-creates one (isAutoCreated=true).
 */
model Task {
  id String @id @default(cuid())

  title       String
  description String?
  relatedType TaskRelatedType
  relatedId   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedStaffId String
  assignedStaff   Staff  @relation("AssignedTasks", fields: [assignedStaffId], references: [id], onDelete: Restrict)

  createdByStaffId String?
  createdByStaff   Staff?  @relation("CreatedTasks", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  isAutoCreated    Boolean @default(false)

  dueDate  DateTime
  priority TaskPriority @default(NORMAL)
  status   TaskStatus   @default(PENDING)

  notes       String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedStaffId])
  @@index([status])
  @@index([dueDate])
  @@index([customerId])
  @@index([leadId])
  @@map("tasks")
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_STAFF
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/**
 * Configurable categories (spec #11) — same admin-extendable-list pattern as LeadStage.
 */
model SupportTicketCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  tickets SupportTicket[]

  @@map("support_ticket_categories")
}

model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  subject     String
  categoryId  String
  category    SupportTicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priority    TicketPriority        @default(NORMAL)
  description String

  assignedStaffId String?
  assignedStaff   Staff?  @relation("AssignedTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  branchId        String?
  branch          Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  status TicketStatus @default(OPEN)

  // SLA (spec #13) snapshotted at creation from the active SlaRule for this
  // priority — a later rule-config change never reaches back and re-dates
  // an in-flight ticket's deadline.
  slaResponseDueAt DateTime?
  firstRespondedAt DateTime?
  slaBreached      Boolean   @default(false)

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    SupportTicketMessage[]
  escalations TicketEscalation[]

  @@index([customerId])
  @@index([status])
  @@index([assignedStaffId])
  @@index([priority])
  @@map("support_tickets")
}

enum TicketMessageAuthorType {
  CUSTOMER
  STAFF
}

/**
 * Doubles as the customer-visible message thread AND the live-chat
 * transport (spec #14) — a "conversation" is a ticket whose messages
 * arrive close together; portals poll this list the same way
 * Notification.listForIdentity is already polled, rather than adding a
 * WebSocket gateway this codebase has never needed. isInternal is spec
 * #12's "clearly separate CUSTOMER MESSAGE from INTERNAL STAFF NOTE" —
 * every customer-facing read path filters it out server-side.
 */
model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType    TicketMessageAuthorType
  authorStaffId String?
  authorStaff   Staff?                  @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  message        String
  isInternal     Boolean @default(false)
  attachmentPath String?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_ticket_messages")
}

/**
 * Spec #13 — configurable per-priority response deadline.
 */
model SlaRule {
  id              String         @id @default(cuid())
  priority        TicketPriority @unique
  responseMinutes Int

  @@map("sla_rules")
}

/**
 * Spec #25 — configurable, ordered escalation steps per priority.
 */
model EscalationRule {
  id String @id @default(cuid())

  priority     TicketPriority
  afterMinutes Int
  notifyRole   String // a SYSTEM_ROLES value, e.g. "BRANCH_MANAGER"
  order        Int
  isActive     Boolean        @default(true)

  @@map("escalation_rules")
}

model TicketEscalation {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  notifiedRole String
  triggeredAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_escalations")
}

enum MessageTemplateChannel {
  EMAIL
  SMS
  WHATSAPP
}

/**
 * Spec #22 — {{variable}} substitution only, never eval()'d: rendering
 * (TemplatesService.render) does one regex pass against a plain
 * string-to-string map and HTML-escapes every substituted value, so a
 * template can never execute code even if a variable's value looks like
 * markup or another template.
 */
model MessageTemplate {
  id      String                 @id @default(cuid())
  key     String                 @unique
  name    String
  channel MessageTemplateChannel
  subject String?
  body    String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

/**
 * Spec #19 — per-identity channel opt-out. A NotificationType listed in
 * MANDATORY_NOTIFICATION_TYPES (notifications constants) always sends
 * regardless of this row — "administrators can define mandatory
 * notifications users cannot disable."
 */
model NotificationPreference {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  inAppEnabled    Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  note String

  createdByStaffId String
  createdByStaff   Staff  @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_notes")
}

/**
 * Spec #3's free-form custom tags — the fixed segment categories (Hajj/Umrah/Visa/Flight/Hotel/New/Returning Customer) are computed from actual bookings in CrmService rather than stored, so they can never drift out of sync with reality.
 */
model CustomerTag {
  id   String @id @default(cuid())
  name String @unique

  assignments CustomerTagAssignment[]

  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedByStaffId String?
  createdAt         DateTime @default(now())

  @@unique([customerId, tagId])
  @@map("customer_tag_assignments")
}

