// Alnajoum Travel ERP — Phase 1 data model
// Identity is the single authentication principal for both customers (public
// website / customer portal) and staff (internal ERP). It carries credentials,
// verification state and role assignments. Domain-specific profile data lives
// in the linked Customer or Staff record, keeping auth concerns separate from
// business data while still allowing one unified login system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityType {
  CUSTOMER
  STAFF
}

enum IdentityStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Identity {
  id           String         @id @default(cuid())
  email        String         @unique
  phone        String?        @unique
  passwordHash String
  type         IdentityType
  status       IdentityStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  staff    Staff?

  roles         IdentityRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([type])
  @@map("identities")
}

model Customer {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  dateOfBirth DateTime?
  nationality String?
  gender      String?

  address String?
  city    String?
  country String?

  passportNumber     String?
  passportExpiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents              CustomerDocument[]
  familyMembers          FamilyMember[]
  flightBookings         FlightBooking[]
  flightBookingPassenger FlightBookingPassenger[]
  invoices               Invoice[]
  paymentIntents         PaymentIntent[]

  @@map("customers")
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  VISA
  PHOTO
  VACCINATION_CERTIFICATE
  BIRTH_CERTIFICATE
  OTHER
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_documents")
}

enum FamilyRelationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  GUARDIAN
  OTHER
}

model FamilyMember {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  relationship FamilyRelationship
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  nationality  String?
  gender       String?
  phone        String?
  email        String?

  passportNumber     String?
  passportExpiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents              FamilyMemberDocument[]
  flightBookingPassenger FlightBookingPassenger[]

  @@index([customerId])
  @@map("family_members")
}

model FamilyMemberDocument {
  id             String       @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  type             DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime @default(now())

  @@index([familyMemberId])
  @@map("family_member_documents")
}

model Staff {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employeeCode String    @unique
  firstName    String
  lastName     String
  jobTitle     String?
  department   String?
  hireDate     DateTime?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookedFlightBookings FlightBooking[]
  issuedInvoices       Invoice[]
  recordedPayments     Payment[]

  @@index([companyId])
  @@index([branchId])
  @@map("staff")
}

model Company {
  id                 String  @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String? @unique
  email              String?
  phone              String?
  address            String?
  website            String?
  logoUrl            String?
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  staff    Staff[]

  @@map("companies")
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  code         String
  address      String?
  city         String?
  state        String?
  country      String?
  phone        String?
  email        String?
  isHeadOffice Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  identities  IdentityRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "company:create", "branch:update"
  module      String // e.g. "company", "branch", "user"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model IdentityRole {
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Optional scope: a role can be granted platform-wide (companyId null) or
  // limited to a specific company/branch (e.g. Branch Manager at Branch X).
  companyId String?
  branchId  String?

  assignedAt DateTime @default(now())

  @@id([identityId, roleId])
  @@index([companyId])
  @@index([branchId])
  @@map("identity_roles")
}

model RefreshToken {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  createdByIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String    @id @default(cuid())
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  action     String // e.g. "auth.login", "company.create"
  entityType String?
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum FlightProviderName {
  MOCK
  DUFFEL
}

enum FlightBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model FlightBooking {
  id               String @id @default(cuid())
  bookingReference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Set when a staff member books on the customer's behalf; null for
  // customer self-service bookings.
  bookedByStaffId String?
  bookedByStaff   Staff?  @relation(fields: [bookedByStaffId], references: [id], onDelete: SetNull)

  provider        FlightProviderName
  providerOfferId String
  providerOrderId String?
  status          FlightBookingStatus @default(PENDING)

  currency    String
  totalAmount Int // whole currency units (e.g. NGN), no minor-unit subdivision

  tripType    TripType
  // Summary columns for indexing/list display, derived from the first and
  // last leg of the itinerary at booking time. The full per-leg routing
  // (all stops for a multi-city trip, or the return leg of a round trip)
  // lives in `itinerary` below.
  origin      String
  destination String
  departureAt DateTime
  cabinClass  CabinClass

  // Full offer snapshot (all legs, segments, fare basis, etc.) as returned
  // by the provider at booking time — provider payloads vary too much in
  // shape to model relationally, and a snapshot also preserves what was
  // actually purchased even if the provider's own record later changes.
  itinerary Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengers FlightBookingPassenger[]
  invoice    Invoice?

  @@index([customerId])
  @@index([status])
  @@index([bookedByStaffId])
  @@map("flight_bookings")
}

model FlightBookingPassenger {
  id        String        @id @default(cuid())
  bookingId String
  booking   FlightBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type PassengerType

  // Exactly one of these is set, identifying who this passenger is.
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  // Snapshot of traveler details at booking time, independent of later
  // profile edits.
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  passportNumber String?
  ticketNumber   String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([customerId])
  @@index([familyMemberId])
  @@map("flight_booking_passengers")
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CARD
  OTHER
  // Customer-initiated checkout through PaymentProviderPort (Paystack in
  // production, the mock provider by default) — the only method not
  // recorded by a staff member.
  ONLINE
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable/unique rather than required: today every invoice is generated
  // from a flight booking, but the shape stays valid for a future
  // standalone invoice (e.g. a manual fee) that isn't tied to one booking.
  flightBookingId String?        @unique
  flightBooking   FlightBooking? @relation(fields: [flightBookingId], references: [id], onDelete: SetNull)

  status InvoiceStatus @default(ISSUED)

  currency    String
  totalAmount Int // whole currency units, no minor-unit subdivision — matches FlightBooking.totalAmount

  // Set when a staff action generated the invoice; null for a
  // system-generated invoice from a customer's own self-service booking.
  issuedByStaffId String?
  issuedByStaff   Staff?  @relation(fields: [issuedByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems      InvoiceLineItem[]
  payments       Payment[]
  paymentIntents PaymentIntent[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  amount      Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id               String @id @default(cuid())
  paymentReference String @unique

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Int
  method PaymentMethod
  note   String?

  // Payments are always recorded by a staff member (cash/bank transfer/POS
  // handled in-office) — there's no customer self-service payment path
  // until a real online gateway (Paystack/Flutterwave) is integrated.
  recordedByStaffId String?
  recordedByStaff   Staff?  @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("payments")
}

/**
 * One customer-initiated online checkout attempt against an invoice.
 * Created PENDING before redirecting to the provider's hosted checkout
 * page; flipped to SUCCEEDED (which also creates the matching Payment row)
 * or FAILED once the provider confirms the outcome — via the browser
 * returning to the verify endpoint, and/or the provider's webhook, since
 * either can arrive first or the browser callback may never happen at all
 * (tab closed mid-payment).
 */
model PaymentIntent {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // The provider's transaction reference — what ties an initiated checkout
  // to the provider's later verify/webhook callback.
  reference String @unique
  provider  String // "mock" | "paystack"

  amount   Int
  currency String

  status PaymentIntentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("payment_intents")
}

enum NotificationType {
  STAFF_TEMP_PASSWORD
  BOOKING_CONFIRMATION
  PAYMENT_RECEIPT
  CONTACT_MESSAGE
}

enum NotificationStatus {
  SENT
  FAILED
}

/**
 * Append-only send log — every attempt is recorded regardless of outcome,
 * so a failed send is visible without needing real inbox access. Not
 * linked to other models by foreign key (mirrors AuditLog): the recipient
 * address and rendered body are the durable record, since the underlying
 * Customer/Staff/Invoice may change or be deleted after the fact.
 */
model Notification {
  id        String             @id @default(cuid())
  type      NotificationType
  recipient String
  subject   String
  body      String
  status    NotificationStatus

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}
