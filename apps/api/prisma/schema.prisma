  coordinatorStaffId String?
  coordinatorStaff   Staff?  @relation("HajjGroupCoordinator", fields: [coordinatorStaffId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilgrims        HajjRegistrationPilgrim[]
