enum TransportType {
  AIRPORT_TRANSFER
  MAKKAH_TRANSPORT
  MADINAH_TRANSPORT
  INTERCITY
  GROUP_BUS
  PRIVATE_VEHICLE
}

enum TransportStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Transport {
  id   String        @id @default(cuid())
  type TransportType

  // Exactly one of these is set — same "exactly one" convention as
  // HajjRegistrationPilgrim.customerId/familyMemberId.
  hajjGroupId  String?
  hajjGroup    HajjGroup?  @relation(fields: [hajjGroupId], references: [id], onDelete: SetNull)
  umrahGroupId String?
  umrahGroup   UmrahGroup? @relation(fields: [umrahGroupId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  pickupLocation  String
  dropoffLocation String
  scheduledAt     DateTime

  status TransportStatus @default(SCHEDULED)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hajjGroupId])
  @@index([umrahGroupId])
  @@map("hajj_ops_transports")
}

enum PilgrimType {
  HAJJ
  UMRAH
}

enum PilgrimCheckInEvent {
  GROUP_CHECK_IN
  AIRPORT
  TRANSPORT
  HOTEL
  DEPARTURE
}

// QR-based check-in event log (spec #34) — the QR payload itself is just
// HajjRegistrationPilgrim/UmrahRegistrationPilgrim.pilgrimCode, an opaque
// internal id that never encodes passport/financial data.
model PilgrimCheckIn {
  id          String      @id @default(cuid())
  pilgrimType PilgrimType
  // Polymorphic by design (HajjRegistrationPilgrim.id or
  // UmrahRegistrationPilgrim.id) — same convention already used for
  // StaffIncentive's sourceType/sourceId pairing.
  pilgrimId   String

  event    PilgrimCheckInEvent
  location String?

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([pilgrimType, pilgrimId])
  @@map("pilgrim_check_ins")
}

enum ReadinessStatus {
  GREEN
  AMBER
  RED
}

// Spec #30: the readiness/departure-checklist status is computed live
// (HajjOpsService.computeReadiness) from real documents/visa/payment/flight/
// hotel state — this table exists only for the explicit, audited manual
// override staff cannot apply without the CHECKLIST_OVERRIDE permission.
model PilgrimReadinessOverride {
  id          String      @id @default(cuid())
  pilgrimType PilgrimType
  pilgrimId   String

  status ReadinessStatus
  reason String

  overriddenByStaffId String
  overriddenByStaff   Staff    @relation(fields: [overriddenByStaffId], references: [id], onDelete: Restrict)
  overriddenAt        DateTime @default(now())

  @@index([pilgrimType, pilgrimId])
  @@map("pilgrim_readiness_overrides")
}

// ---------------------------------------------------------------------------
// Phase 8 continued — room allocation, group manifest support.
// Deliberately a lightweight, group-scoped room roster rather than wiring
// into the Phase 5 Hotel/HotelRoomType catalog: HajjPackage/UmrahPackage's
// `hotel` field has always been free text (packages aren't booked through
// the catalog), so a room here is identified by hotelName/roomNumber, not a
// HotelRoomType id. Capacity conflicts are prevented at the application
// layer (RoomAllocationService.assign), not a DB constraint, since the room
// "capacity" is data (varies per room), not a fixed schema shape.
// ---------------------------------------------------------------------------

model RoomAllocation {
  id String @id @default(cuid())

  hajjGroupId  String?
  hajjGroup    HajjGroup?  @relation(fields: [hajjGroupId], references: [id], onDelete: Cascade)
  umrahGroupId String?
  umrahGroup   UmrahGroup? @relation(fields: [umrahGroupId], references: [id], onDelete: Cascade)

  // Snapshotted at creation time — always equal to hotelBooking.hotelName
  // when linked (see RoomAllocationService.create), free text otherwise.
  // Packages have never been booked through the Phase 5 catalog (see this
  // file's Phase 8 header comment), so free text stays the default; this
  // link is what "deeper hotel-catalog integration" means in practice —
  // an optional, traceable connection to a real, priced, dated booking
  // when ops actually makes one, not a requirement to always have one.
  hotelName String

  hotelBookingId String?
  hotelBooking   HotelBooking? @relation(fields: [hotelBookingId], references: [id], onDelete: SetNull)

  roomType   String? // e.g. "Double", "Quad" — free text, matches package.hotel's own convention
  roomNumber String
  capacity   Int     @default(2)

  occupants RoomAllocationOccupant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hajjGroupId])
  @@index([umrahGroupId])
  @@map("room_allocations")
}

model RoomAllocationOccupant {
  id               String         @id @default(cuid())
  roomAllocationId String
  roomAllocation   RoomAllocation @relation(fields: [roomAllocationId], references: [id], onDelete: Cascade)

  pilgrimType PilgrimType
  pilgrimId   String

  checkedInAt DateTime?

  createdAt DateTime @default(now())

  // A pilgrim occupies at most one room per allocation batch — same pilgrim
  // can't be double-booked into two rooms of the same group.
  @@unique([roomAllocationId, pilgrimType, pilgrimId])
  @@index([pilgrimType, pilgrimId])
  @@map("room_allocation_occupants")
}

// ---------------------------------------------------------------------------
// Phase 11 — Enterprise Administration, Security, Multi-Tenant Controls &
// System Governance. Builds on what already existed rather than duplicating
// it: Company already IS the tenant boundary (spec #2), IdentityRole already
// supports company/branch-scoped role grants (spec #6), RefreshToken already
// carries most of a "session" (spec #16), Identity.twoFactorEnabled/
// twoFactorSecret columns already existed but were never wired to anything
// (spec #15) — TwoFactorRecoveryCode below is the one genuinely missing
// piece for that. AuditLog (extended above) remains the single audit trail
// rather than a parallel "SecurityEvent" table — security events are just
// AuditLog rows with a "security.*" action prefix, keeping one place to
// search (spec #18/#25/#26).
// ---------------------------------------------------------------------------

/**
 * Spec #15 — TOTP recovery codes. Stored hashed (argon2, same as
 * passwords) and single-use; shown to the identity in full exactly once,
 * at generation time, then never again (TwoFactorService never returns
 * the plaintext after that response).
 */
model TwoFactorRecoveryCode {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([identityId])
  @@map("two_factor_recovery_codes")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/**
 * Spec #19 — machine-to-machine API access, separate from the
 * user-session JWT flow. The raw key is shown once at creation and never
 * stored or displayed again — only its hash and a short, non-secret
 * prefix (for the owner to recognize which key is which in a list).
 */
model ApiKey {
  id             String       @id @default(cuid())
  ownerIdentityId String
  ownerIdentity   Identity    @relation(fields: [ownerIdentityId], references: [id], onDelete: Cascade)

  name        String
  keyPrefix   String // first 8 chars of the raw key, safe to display — lets the owner tell keys apart without ever re-showing the secret
  keyHash     String @unique
  permissions String[] // subset of PERMISSIONS keys this key may exercise — never broader than its owner's own roles

  status     ApiKeyStatus @default(ACTIVE)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([ownerIdentityId])
  @@map("api_keys")
}

// Named ApprovalRequestStatus, not ApprovalStatus, to avoid colliding with
// the pre-existing ApprovalStatus enum (PENDING/APPROVED/REJECTED) used by
// VisaApplication.approvalStatus/CorporateAccount's corporateApprovalStatus
// — those ad hoc per-module flows are untouched by this generic engine.
enum ApprovalRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/**
 * Spec #10/#11 — a reusable, generic approval workflow that any module can
 * route a sensitive action through, rather than every module inventing
 * its own ad hoc approval state machine. This does NOT replace the
 * existing narrower approval patterns that already work (ManualPayment
 * Submission's finance review, Phase 10's manual-booking approval gate,
 * StaffIncentive's own PENDING->APPROVED lifecycle) — those stay exactly
 * as they are. This is for NEW call sites (see FlightRefundsService's
 * threshold check) that need configurable multi-level approval with
 * amount-based thresholds, which nothing existing provides.
 */
model ApprovalRequest {
  id String @id @default(cuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  type   String // e.g. "FLIGHT_REFUND", "SUPPLIER_PAYMENT" — matches ApprovalThresholdRule.type
  amount Int?
  currency String?

  entityType String? // e.g. "FlightRefund"
  entityId   String?

  requestedByIdentityId String
  requestedBy           Identity @relation("ApprovalRequester", fields: [requestedByIdentityId], references: [id], onDelete: Restrict)
  reason                String?

  status ApprovalRequestStatus @default(REQUESTED)

  // Snapshot of what would change if approved, and what actually changed
  // once it is — spec #11's "record previous state / new state".
  previousState Json?
  newState      Json?

  requiredApprovals Int @default(1) // resolved from ApprovalThresholdRule at creation time — never recomputed later, so a mid-flight threshold change can't retroactively change what a pending request needs
  decisions ApprovalDecision[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  @@index([companyId])
  @@index([status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

/**
 * One approver's decision on an ApprovalRequest. Multiple rows accumulate
 * for a multi-level request; ApprovalService.decide() flips the parent to
 * APPROVED only once enough APPROVED decisions exist to meet
 * requiredApprovals, and to REJECTED immediately on the first rejection
 * (a single "no" stops the request, same as most real approval chains).
 */
model ApprovalDecision {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  decidedByIdentityId String
  decidedBy           Identity @relation("ApprovalDecider", fields: [decidedByIdentityId], references: [id], onDelete: Restrict)

  decision ApprovalDecisionType
  reason   String? // required for REJECTED — enforced in ApprovalService, not the DB

  createdAt DateTime @default(now())

  // Spec #11 — a person decides on a given request at most once; the
  // self-approval rule (decidedByIdentityId != requestedByIdentityId) is
  // enforced in ApprovalService since it spans two tables.
  @@unique([approvalRequestId, decidedByIdentityId])
  @@map("approval_decisions")
}

/**
 * Spec #10 — configurable amount-based approval thresholds, resolved
 * most-specific-first as usual across this codebase (a companyId-scoped
 * rule beats the platform-wide default). minAmount/maxAmount define the
 * band this rule covers; null maxAmount means "and above".
 */
model ApprovalThresholdRule {
  id        String  @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type              String // e.g. "FLIGHT_REFUND"
  minAmount         Int    @default(0)
  maxAmount         Int? // null = no upper bound
  requiredApprovals Int    @default(1)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@map("approval_threshold_rules")
}

/**
 * Spec #39 — feature flags. A flag with no override row is off by
 * default (isEnabledByDefault decides), matching "never invented/assumed
 * on" discipline used elsewhere in this codebase. Per-tenant overrides
 * are additive, never used to bypass a permission check (spec #39's own
 * warning) — every gated call site still runs its normal RBAC guard.
 */
model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "ENABLE_HAJJ"
  description String?
  isEnabledByDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id            String      @id @default(cuid())
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isEnabled Boolean

  updatedAt DateTime @updatedAt

  @@unique([featureFlagId, companyId])
  @@map("feature_flag_overrides")
}

/**
 * Spec #20 — centralized, database-backed settings for cross-cutting
 * configuration that doesn't already have a home (finance-specific
 * config lives in FinanceSettings, provider credentials in
 * IntegrationCredential — this is deliberately NOT a duplicate of
 * either). companyId null = platform-wide default; a company-scoped row
 * overrides it, same most-specific-wins pattern used throughout.
 */
model SystemSetting {
  id        String  @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category String // e.g. "SECURITY", "PASSWORD_POLICY"
  key      String // e.g. "MAX_FAILED_LOGIN_ATTEMPTS"
  value    Json

  updatedByIdentityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history SystemSettingHistory[]

  @@unique([companyId, category, key])
  @@map("system_settings")
}

/**
 * Spec #38 — configuration versioning. One row per change, written
 * alongside every SystemSetting update, never edited afterward.
 */
model SystemSettingHistory {
  id              String        @id @default(cuid())
  systemSettingId String
  systemSetting   SystemSetting @relation(fields: [systemSettingId], references: [id], onDelete: Cascade)

  previousValue Json?
  newValue      Json
  changedByIdentityId String?
  reason        String?

  createdAt DateTime @default(now())

  @@index([systemSettingId])
  @@map("system_setting_history")
}

/**
 * Spec #21 — reference currency data for display/lookup. A booking's own
 * transaction currency (e.g. FlightBooking.currency) is always stored as
 * its own string field and is never overwritten when a rate here
 * changes — this table never touches historical transaction values.
 */
model Currency {
  code           String  @id // ISO 4217, e.g. "NGN"
  name           String
  symbol         String
  decimalPlaces  Int     @default(2)
  exchangeRateToBase Float @default(1) // relative to the platform base currency (NGN)
  isActive       Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("currencies")
}

/**
 * Spec #22 — configurable tax rules. CRUD/lookup only in this phase; not
 * wired into every module's pricing engine yet (each module's existing
 * markup/fee engine — FlightPricingRule, FlightServiceFee, etc. — keeps
 * working exactly as before). A future phase can have those engines
 * resolve a TaxRule the same way they resolve a FlightServiceFee today.
 */
model TaxRule {
  id                String   @id @default(cuid())
  name              String
  ratePercent       Float?
  fixedAmount       Int?
  isInclusive       Boolean  @default(false)
  applicableService String? // e.g. "FLIGHT", "HOTEL" — free text, mirrors FlightServiceFeeType's own looseness
  country           String?
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicableService, isActive])
  @@map("tax_rules")
}
