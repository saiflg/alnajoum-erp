  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

// Internal fleet used for pilgrim transport — deliberately distinct from
// VehicleRental (a customer-facing marketplace booking with a third-party
// provider); no overlap in purpose or data.
model Vehicle {
