// ---------------------------------------------------------------------------
// Phase 8 — Enterprise Hajj & Umrah pilgrim management, operations & group
// control. Deliberately reuses existing infrastructure rather than
// duplicating it:
//   - A "pilgrim" is still a HajjRegistrationPilgrim/UmrahRegistrationPilgrim
//     row, already linked to Customer/FamilyMember without a new table —
//     groups below are pure travel-cohort containers pilgrims optionally
//     join, not a parallel pilgrim record.
//   - Installments, amount paid, and outstanding balance are computed from
//     the existing HajjRegistration/UmrahRegistration → Invoice → Payment
//     chain (see HajjOpsService), never re-stored here.
//   - Visa/flight/hotel readiness is computed by matching a pilgrim's
//     customerId/familyMemberId against VisaApplication/FlightBookingPassenger
//     /HotelBookingGuest at read time — no synced/duplicated status field.
//   - Operational reminder tasks reuse the Phase 7 Task model
//     (relatedType: HAJJ_GROUP/UMRAH_GROUP) and TasksService.createAuto's
//     existing idempotency, not a second task system.
// ---------------------------------------------------------------------------

enum TravelGroupStatus {
  PLANNING
  REGISTRATION_OPEN
  ALMOST_FULL
  FULL
  DEPARTED
  IN_SAUDI_ARABIA
  RETURNING
  COMPLETED
  CANCELLED
