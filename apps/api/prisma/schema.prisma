/**
 * Spec #23 — isApproved gates visibility; nothing publishes a rating/comment automatically.
 */
model CustomerFeedback {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  serviceType String
  sourceType  String?
  sourceId    String?

  rating      Int
  staffRating Int?
  comment     String?

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  isApproved        Boolean @default(false)
  approvedByStaffId String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_feedback")
}

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  INVESTIGATING
  RESOLVED
  ESCALATED
  CLOSED
}

model Complaint {
  id              String @id @default(cuid())
  complaintNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  subject     String
  description String
  status      ComplaintStatus @default(SUBMITTED)

  assignedStaffId String?
  assignedStaff   Staff?  @relation("AssignedComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  resolution  String?
  resolvedAt  DateTime?
  escalatedTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes ComplaintNote[]

  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model ComplaintNote {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  note       String
  isInternal Boolean @default(true)

  createdByStaffId String
  createdByStaff   Staff  @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@map("complaint_notes")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  targetService  String
  targetAudience String?

  startDate DateTime
  endDate   DateTime?
  budget    Int?
  channel   String?

  status CampaignStatus @default(DRAFT)

  createdByStaffId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@map("campaigns")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
}

model ReferralCode {
  id         String   @id @default(cuid())
  code       String   @unique
  customerId String   @unique
  customer   Customer @relation("ReferralCodeOwner", fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  referrals Referral[]

  @@map("referral_codes")
}

model Referral {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)

  referredCustomerId String   @unique
  referredCustomer   Customer @relation("ReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)

  serviceType       String?
  transactionId     String?
