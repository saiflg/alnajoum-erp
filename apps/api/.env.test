DATABASE_URL="postgresql://alnajoum:alnajoum_dev_password@localhost:5432/alnajoum_erp_test?schema=public"
REDIS_URL="redis://localhost:6379"

NODE_ENV=test
PORT=4001

JWT_ACCESS_SECRET=test_access_secret_do_not_use_in_production_1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_in_production_1234567890
