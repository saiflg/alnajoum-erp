CORS_ORIGIN=http://localhost:3000

UPLOADS_DIR=./uploads-test

# Lets payment-gateway.e2e-spec.ts exercise the real webhook signature
# check end to end (a genuine HMAC computed with this key, not a real
# Paystack account) — PAYMENT_PROVIDER itself stays "mock" (the default)
# for every other test, since there's no live Paystack account to test
# actual checkout against.
PAYSTACK_SECRET_KEY=test_paystack_secret_do_not_use_in_production
