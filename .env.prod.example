# Copy this to .env.prod on the server (NOT into git) and fill in real
# values. Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...
# See DEPLOYMENT.md for how each of these is generated/obtained.

# --- Postgres ---
POSTGRES_USER=alnajoum
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=alnajoum_erp

# --- Public origin ---
# Start with the server's IP (no domain yet):
#   PUBLIC_ORIGIN=http://<your-vm-public-ip>
#   SITE_ADDRESS=:80
# Once you have a domain pointed at the server:
#   PUBLIC_ORIGIN=https://yourdomain.com
#   SITE_ADDRESS=yourdomain.com
PUBLIC_ORIGIN=http://<your-vm-public-ip>
SITE_ADDRESS=:80

# --- API secrets ---
# Generate each with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me
JWT_REFRESH_EXPIRES_IN=7d
# Encrypts integration secrets stored in the database. REQUIRED: the API refuses to start without it.
# Generate: echo "2026a:$(openssl rand -base64 32)"   Keep a copy OUTSIDE the server — losing it makes
# stored integration secrets unreadable (you would re-enter them).
DATA_ENCRYPTION_KEYS=replace_me
DATA_ENCRYPTION_KEY_ID=

# --- First Super Admin (used only by `prisma db seed` when no such user exists) ---
# REQUIRED in production: a real address and a 12+ character password that is not written anywhere
# else. Change it after first login; it is never printed.
BOOTSTRAP_ADMIN_EMAIL=replace_me@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=replace_me

# --- Notifications (optional — defaults to "mock", which logs instead of
# sending; switch to "smtp" once you have real mailbox credentials) ---
NOTIFICATION_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Alnajoum Travel <no-reply@yourdomain.com>"
CONTACT_RECIPIENT_EMAIL=alnajoumtravelagency@gmail.com

# --- Online payments (REQUIRED to be real in production) ---
# "mock" reports every payment as successful, so the API REFUSES TO START with it when
# NODE_ENV=production. Use "paystack" (secret key from https://dashboard.paystack.com) or "opay"
# (merchant account from https://merchant.opayweb.com).
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=

# --- AI analytics assistant (optional — defaults to "mock", which needs no
# credentials and answers with simple keyword matching; switch to
# "openai-compatible" once you have a real key from
# https://platform.openai.com or another OpenAI-compatible provider). Both
# of these can also be set at /admin/integrations instead, which takes
# effect immediately with no restart. ---
AI_PROVIDER=mock
AI_API_KEY=
