# Copy this to .env.prod on the server (NOT into git) and fill in real
# values. Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...
# See DEPLOYMENT.md for how each of these is generated/obtained.

# --- Postgres ---
POSTGRES_USER=alnajoum
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=alnajoum_erp

# --- Public origin ---
# Start with the server's IP (no domain yet):
#   PUBLIC_ORIGIN=http://<your-vm-public-ip>
#   SITE_ADDRESS=:80
# Once you have a domain pointed at the server:
#   PUBLIC_ORIGIN=https://yourdomain.com
#   SITE_ADDRESS=yourdomain.com
PUBLIC_ORIGIN=http://<your-vm-public-ip>
SITE_ADDRESS=:80

# --- API secrets ---
# Generate each with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me
JWT_REFRESH_EXPIRES_IN=7d

# --- Notifications (optional — defaults to "mock", which logs instead of
# sending; switch to "smtp" once you have real mailbox credentials) ---
NOTIFICATION_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Alnajoum Travel <no-reply@yourdomain.com>"
CONTACT_RECIPIENT_EMAIL=alnajoumtravelagency@gmail.com

# --- Online payments (optional — defaults to "mock", which simulates a
# successful checkout with no real gateway; switch to "paystack" once you
# have a real secret key from https://dashboard.paystack.com) ---
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
