# --- Local infra (docker-compose) ---
POSTGRES_USER=alnajoum
POSTGRES_PASSWORD=alnajoum_dev_password
POSTGRES_DB=alnajoum_erp
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api/.env) ---
DATABASE_URL="postgresql://alnajoum:alnajoum_dev_password@localhost:5432/alnajoum_erp?schema=public"
REDIS_URL="redis://localhost:6379"

NODE_ENV=development
PORT=4000

JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

UPLOADS_DIR=./uploads
# Optional. Laplacian-variance threshold below which a passport image upload
# is rejected as too blurry to read. Defaults to 20 if unset — see
# apps/api/src/common/documents/image-quality.util.ts for how it's derived.
# DOCUMENT_BLUR_THRESHOLD=20

# Optional. 'mock' (default) simulates a successful checkout without a real
# gateway; 'paystack' uses the real Paystack API (needs PAYSTACK_SECRET_KEY,
# a free test key from https://dashboard.paystack.com).
# PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# The web app's own origin — used to build the checkout callback URL and,
# for the mock provider, its checkout page's URL.
PUBLIC_WEB_ORIGIN=http://localhost:3000

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
